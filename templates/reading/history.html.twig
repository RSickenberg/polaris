{% extends 'base.html.twig' %}

{% block title %}{{ 'page.history.title'|trans({'%vehicle%': vehicle.name}, 'reading') }}{% endblock %}

{% block body %}
    <h1>{{ 'page.history.title'|trans({'%vehicle%': vehicle.name}, 'reading') }}</h1>

    {% for message in app.flashes('success') %}
        <p role="status">{{ message }}</p>
    {% endfor %}

    <h2>{{ 'page.history.add'|trans(domain='reading') }}</h2>
    {{ form(form) }}

    <h2>{{ 'page.history.readings'|trans(domain='reading') }}</h2>
    {{ include('reading/_table.html.twig') }}
{% endblock %}

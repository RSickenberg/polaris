{% extends 'base.html.twig' %}

{% block title %}{{ 'page.history.title'|trans(domain='reading') }} | {{ vehicle.name }}{% endblock %}

{% block main %}
    <h1 class="text-2xl font-semibold tracking-tight">{{ 'page.history.title'|trans(domain='reading') }} <span class="font-normal text-muted-foreground">| {{ vehicle.name }}</span></h1>

    <div class="max-w-3xl">{{ include('shared/_flashes.html.twig') }}</div>

    <h2 class="mt-8 mb-3 text-lg font-semibold">{{ 'page.history.add'|trans(domain='reading') }}</h2>
    <div class="max-w-3xl">
        {{ form(form) }}
    </div>

    <h2 class="mt-8 mb-3 text-lg font-semibold">{{ 'page.history.readings'|trans(domain='reading') }}</h2>
    {{ include('reading/_table.html.twig') }}
{% endblock %}

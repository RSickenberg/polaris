{% extends 'base.html.twig' %}

{% block title %}{{ 'page.history.title'|trans(domain='reading') }} | {{ vehicle.name }}{% endblock %}

{% block main %}
    <twig:Shared:PageHeader title="{{ 'page.history.title'|trans(domain='reading') }}" subject="{{ vehicle.name }}" />

    <div class="mt-6 flex flex-col gap-6">
        <twig:Card class="max-w-3xl">
            <twig:Card:Header>
                <twig:Card:Title><h2>{{ 'page.history.add'|trans(domain='reading') }}</h2></twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ form_start(form) }}
                    <div class="flex flex-col gap-4">
                        {{ form_errors(form) }}
                        {{ form_row(form.readAt) }}
                        {# The unit on the right of the value it applies to. #}
                        <div class="grid grid-cols-[minmax(0,1fr)_6.5rem] items-start gap-x-2">
                            {{ form_row(form.odometer) }}
                            {{ form_row(form.distanceUnit) }}
                        </div>
                        {{ form_row(form.save) }}
                    </div>
                {{ form_end(form) }}
            </twig:Card:Content>
        </twig:Card>

        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title><h2>{{ 'page.history.readings'|trans(domain='reading') }}</h2></twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content>
                {{ include('reading/_table.html.twig') }}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}

{# The readings, newest first. Dates are stored in UTC and converted to `timeZone` (an IANA name) only here, with the offset, which tells apart the two 02:30 of a daylight saving change. On a phone the date wraps, and the value the car reported (in miles for Tesla) sits under the odometer. #}
{% if readings is empty %}
    <p class="text-sm text-muted-foreground">{{ 'table.empty'|trans(domain='reading') }}</p>
{% else %}
    <twig:Table>
        <twig:Table:Header>
            <twig:Table:Row>
                <twig:Table:Head class="whitespace-normal">{{ 'table.read_at'|trans({'%timezone%': timeZone}, 'reading') }}</twig:Table:Head>
                <twig:Table:Head>{{ 'table.odometer'|trans(domain='reading') }}</twig:Table:Head>
                <twig:Table:Head>{{ 'table.source'|trans(domain='reading') }}</twig:Table:Head>
            </twig:Table:Row>
        </twig:Table:Header>
        <twig:Table:Body>
            {% for reading in readings %}
                <twig:Table:Row>
                    <twig:Table:Cell class="whitespace-normal">{{ reading.readAt|localized_datetime(timeZone) }}</twig:Table:Cell>
                    <twig:Table:Cell>
                        {{ reading.odometer|km(1) }}
                        {% if reading.odometerRaw is not null %}
                            <span class="block text-xs text-muted-foreground">{{ (reading.odometerRaw * 1)|figure(3) }} {{ ('unit.' ~ reading.odometerRawUnit.value)|trans(domain='shared') }}</span>
                        {% endif %}
                    </twig:Table:Cell>
                    <twig:Table:Cell>{{ ('source.' ~ reading.source.value)|trans(domain='reading') }}</twig:Table:Cell>
                </twig:Table:Row>
            {% endfor %}
        </twig:Table:Body>
    </twig:Table>
{% endif %}

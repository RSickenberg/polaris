{% extends 'base.html.twig' %}

{% set id = vehicle.id.toBase32() %}
{% set state = dashboard.state.value %}
{% set km = enum('Polaris\\Shared\\Domain\\DistanceUnit').Kilometre %}

{% block title %}{{ 'page.title'|trans(domain='dashboard') }} | {{ vehicle.name }}{% endblock %}

{% block main %}
    <h1 class="text-2xl font-semibold tracking-tight">{{ 'page.title'|trans(domain='dashboard') }} <span class="font-normal text-muted-foreground">| {{ vehicle.name }}</span></h1>

    {{ include('shared/_flashes.html.twig') }}

    <div class="mt-6 flex flex-col gap-6">
        {% if 'no_lease' == state %}
            {{ include('dashboard/_empty.html.twig', {text: 'empty.no_lease.text'|trans(domain='dashboard'), cta: 'empty.no_lease.cta'|trans(domain='dashboard'), href: path('lease_settings', {id: id})}) }}
        {% elseif 'no_reading' == state %}
            {{ include('dashboard/_empty.html.twig', {text: 'empty.no_reading.text'|trans(domain='dashboard'), cta: 'empty.no_reading.cta'|trans(domain='dashboard'), href: path('reading_history', {id: id})}) }}
        {% elseif 'draft' == state %}
            {{ include('dashboard/_empty.html.twig', {text: 'empty.draft.text'|trans(domain='dashboard'), cta: 'empty.draft.cta'|trans(domain='dashboard'), href: path('lease_settings', {id: id})}) }}
        {% else %}
            {% set assessment = dashboard.assessment %}
            {% set projection = assessment.projection %}
            {% set progress = dashboard.progress %}
            {% set unit = 'unit.km'|trans(domain='shared') %}
            {% set ended = 'ended' == state %}
            {% set excess = assessment.projectedExcess.metres / 1000 %}
            {% set cost = assessment.projectedExcessCost.toDecimal()|format_currency(assessment.projectedExcessCost.currency.value) %}
            {% set cut = assessment.weeklyCut %}

            {% if ended %}
                {{ include('dashboard/_empty.html.twig', {text: 'ended.text'|trans(domain='dashboard'), cta: 'ended.cta'|trans(domain='dashboard'), href: path('lease_settings', {id: id})}) }}
            {% endif %}

            <twig:Dashboard:RiskAlert :level="assessment.riskLevel.value">
                {%- if ended -%}
                    {%- if 'over' == assessment.riskLevel.value -%}
                        {{- 'risk.message.ended_over'|trans({excess: excess, unit: unit, cost: cost}, 'dashboard') -}}
                    {%- else -%}
                        {{- 'risk.message.ended_ok'|trans({allowance: dashboard.allowance.metres / 1000, unit: unit}, 'dashboard') -}}
                    {%- endif -%}
                {%- elseif 'over' == assessment.riskLevel.value -%}
                    {%- if cut is not null and not cut.isNegative and cut.metres > 0 -%}
                        {{- 'risk.message.over'|trans({excess: excess, unit: unit, cost: cost, cut: cut.metres / 1000}, 'dashboard') -}}
                    {%- else -%}
                        {{- 'risk.message.over_no_cut'|trans({excess: excess, unit: unit, cost: cost}, 'dashboard') -}}
                    {%- endif -%}
                {%- else -%}
                    {{- ('risk.message.' ~ assessment.riskLevel.value)|trans({projected: projection.projectedAtEnd.metres / 1000, allowance: dashboard.allowance.metres / 1000, unit: unit}, 'dashboard') -}}
                {%- endif -%}
            </twig:Dashboard:RiskAlert>

            {% if not ended %}
                <div class="grid gap-4 lg:grid-cols-3">
                    <twig:Dashboard:PaceCard
                        key="current"
                        title="{{ 'current_pace.title'|trans(domain='dashboard') }}"
                        basis="{{ 'current_pace.basis'|trans(domain='dashboard') }}"
                        :budget="assessment.currentPace"
                    />
                    <twig:Dashboard:PaceCard
                        key="budget"
                        title="{{ 'budget.title'|trans(domain='dashboard') }}"
                        basis="{{ 'budget.basis'|trans(domain='dashboard') }}"
                        :budget="assessment.budget"
                        fallback="{{ 'budget.none'|trans(domain='dashboard') }}"
                    />
                    <twig:Dashboard:PaceCard
                        key="even"
                        title="{{ 'even_pace.title'|trans(domain='dashboard') }}"
                        basis="{{ 'even_pace.basis'|trans(domain='dashboard') }}"
                        :budget="dashboard.evenPace"
                    />
                </div>
            {% endif %}

            <twig:Card>
                <twig:Card:Content>
                    <twig:Dashboard:LeaseProgress
                        :used="progress.usedPercent"
                        :earned="progress.earnedPercent"
                        :level="assessment.riskLevel.value"
                        label="{{ 'progress.label'|trans(domain='dashboard') }}"
                        valueText="{{ 'progress.value_text'|trans({share: progress.usedPercent / 100}, 'dashboard') }}"
                        tickLabel="{{ 'progress.tick'|trans(domain='dashboard') }}"
                    />
                </twig:Card:Content>
            </twig:Card>

            <twig:Card>
                <twig:Card:Header>
                    <twig:Card:Title>{{ 'chart.title'|trans(domain='dashboard') }}</twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content>
                    <twig:Dashboard:MileageChart
                        :series="dashboard.mileage"
                        :level="assessment.riskLevel.value"
                        locale="{{ app.request.locale }}"
                        timeZone="{{ timeZone }}"
                        label="{{ 'chart.label'|trans(domain='dashboard') }}"
                        actualLabel="{{ 'chart.series.actual'|trans(domain='dashboard') }}"
                        allowedLabel="{{ 'chart.series.allowed'|trans(domain='dashboard') }}"
                        projectionLabel="{{ 'chart.series.projection'|trans(domain='dashboard') }}"
                        distanceLabel="{{ 'chart.axis.distance'|trans({'%unit%': unit}, 'dashboard') }}"
                        :ranges="dashboard.mileageRanges"
                        :rangeLabels="{week: 'chart.range.week'|trans(domain='dashboard'), month: 'chart.range.month'|trans(domain='dashboard'), year: 'chart.range.year'|trans(domain='dashboard'), forecast: 'chart.range.forecast'|trans(domain='dashboard'), all: 'chart.range.all'|trans(domain='dashboard')}"
                        rangesLabel="{{ 'chart.range.label'|trans(domain='dashboard') }}"
                    />
                </twig:Card:Content>
            </twig:Card>

            <div class="grid gap-4 sm:grid-cols-2">
                <twig:Dashboard:KpiCard
                    label="{{ 'kpi.driven'|trans(domain='dashboard') }}"
                    value="{{ 'value.distance'|trans({distance: projection.driven.metres / 1000, unit: unit}, 'dashboard') }}"
                    hint="{{ 'kpi.driven.hint'|trans({odometer: (projection.driven.metres + dashboard.startOdometer.metres) / 1000, start: dashboard.startOdometer.metres / 1000, unit: unit}, 'dashboard') }}"
                />
                <twig:Dashboard:KpiCard
                    label="{{ 'kpi.allowed'|trans(domain='dashboard') }}"
                    value="{{ 'value.distance'|trans({distance: projection.allowedToDate.metres / 1000, unit: unit}, 'dashboard') }}"
                    hint="{{ 'kpi.allowed.hint'|trans({sign: projection.margin.isNegative ? 'negative' : 'other', margin: projection.margin.absolute.metres / 1000, unit: unit}, 'dashboard') }}"
                />
                {% if not ended %}
                    <twig:Dashboard:KpiCard
                        label="{{ 'kpi.projected'|trans(domain='dashboard') }}"
                        value="{{ 'value.distance'|trans({distance: projection.projectedAtEnd.metres / 1000, unit: unit}, 'dashboard') }}"
                        hint="{{ 'kpi.projected.hint'|trans({allowance: dashboard.allowance.metres / 1000, unit: unit}, 'dashboard') }}"
                    />
                {% endif %}
                <twig:Dashboard:KpiCard
                    label="{{ 'kpi.last_reading.label'|trans(domain='dashboard') }}"
                    value="{{ projection.asOf|humanized_datetime(timeZone) }}"
                    hint="{{ 'kpi.last_reading.hint'|trans({'%timezone%': timeZone}, 'dashboard') }}"
                />
            </div>

            {% if not ended %}
                <twig:Fetching:OdometerRefreshButton :vehicleId="vehicle.id.toRfc4122()" />
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

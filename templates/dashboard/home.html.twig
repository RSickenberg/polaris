{% extends 'base.html.twig' %}

{% block title %}{{ 'page.home.title'|trans(domain='dashboard') }}{% endblock %}

{% block main %}
    <twig:Shared:PageHeader title="{{ 'page.home.title'|trans(domain='dashboard') }}">
        {% if vehicles is not empty %}
            <twig:Button as="a" variant="outline" href="{{ path('vehicle_import') }}" class="w-full sm:w-auto">{{ 'home.import'|trans(domain='dashboard') }}</twig:Button>
        {% endif %}
    </twig:Shared:PageHeader>

    <div class="mt-6 flex flex-col gap-4">
        {% for vehicle in vehicles %}
            <twig:Dashboard:VehicleCard :card="cards[vehicle.id.toBase32()]" :vehicle="vehicle" timeZone="{{ timeZone }}" />
        {% else %}
            {{ include('dashboard/_empty.html.twig', {
                text: 'page.home.empty'|trans(domain='dashboard'),
                cta: 'home.import'|trans(domain='dashboard'),
                href: path('vehicle_import'),
            }) }}
        {% endfor %}
    </div>
{% endblock %}

{# A note with a call to action, in the info tone of app.css. Needs `text` and `cta` (translated), and `href`. #}
<twig:Card class="gap-4 bg-info-surface text-info-foreground ring-info!" data-empty-state>
    <twig:Card:Content class="flex items-start gap-3">
        <twig:ux:icon name="lucide:info" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
        <p class="text-sm">{{ text }}</p>
    </twig:Card:Content>
    <twig:Card:Content>
        <twig:Button as="a" href="{{ href }}" class="h-10 w-full sm:w-auto">{{ cta }}</twig:Button>
    </twig:Card:Content>
</twig:Card>

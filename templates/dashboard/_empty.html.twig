{# A note with a call to action, tinted blue (info, like the green and red of the alerts). Needs `text` and `cta` (translated), and `href`. #}
<twig:Card class="gap-4 bg-blue-50 text-blue-900 ring-blue-600/50! dark:bg-blue-950/40 dark:text-blue-200 dark:ring-blue-400/40!" data-empty-state>
    <twig:Card:Content class="flex items-start gap-3">
        <twig:ux:icon name="lucide:info" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
        <p class="text-sm">{{ text }}</p>
    </twig:Card:Content>
    <twig:Card:Content>
        <twig:Button as="a" href="{{ href }}" class="h-10 w-full">{{ cta }}</twig:Button>
    </twig:Card:Content>
</twig:Card>

{% extends 'base.html.twig' %}

{% block title %}{{ 'page.debug.title'|trans(domain='dashboard') }}{% endblock %}

{% block main %}
    <twig:Shared:PageHeader title="{{ 'page.debug.title'|trans(domain='dashboard') }}" />

    <div class="mt-6 flex flex-col gap-6">
        <twig:Alert>
            <twig:ux:icon name="lucide:info" aria-hidden="true" />
            <twig:Alert:Description>{{ 'debug.intro'|trans(domain='dashboard') }}</twig:Alert:Description>
        </twig:Alert>

        <twig:Card data-debug="runtime">
            <twig:Card:Header>
                <twig:Card:Title><h2>{{ 'debug.runtime_title'|trans(domain='dashboard') }}</h2></twig:Card:Title>
            </twig:Card:Header>
            <twig:Card:Content>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_1fr]">
                    {% for key, value in runtime %}
                        <dt class="text-muted-foreground">{{ ('debug.runtime.' ~ key)|trans(domain='dashboard') }}</dt>
                        <dd class="font-mono" data-runtime="{{ key }}">{{ value }}</dd>
                    {% endfor %}
                </dl>
            </twig:Card:Content>
        </twig:Card>

        {% for table in tables %}
            <twig:Card data-debug-table="{{ table.name }}">
                <twig:Card:Header>
                    <twig:Card:Title>
                        <h2 class="flex flex-wrap items-baseline gap-x-3">
                            <span class="font-mono">{{ table.name }}</span>
                            <span class="text-sm font-normal text-muted-foreground">{{ 'debug.rows'|trans({shown: table.rows|length, total: table.total}, 'dashboard') }}</span>
                        </h2>
                    </twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content>
                    {% if table.rows is empty %}
                        <p class="text-sm text-muted-foreground">{{ 'debug.empty'|trans(domain='dashboard') }}</p>
                    {% else %}
                        <twig:Table>
                            <twig:Table:Header>
                                <twig:Table:Row>
                                    {% for column in table.columns %}
                                        <twig:Table:Head class="font-mono text-xs">{{ column }}</twig:Table:Head>
                                    {% endfor %}
                                </twig:Table:Row>
                            </twig:Table:Header>
                            <twig:Table:Body>
                                {% for row in table.rows %}
                                    <twig:Table:Row>
                                        {% for column in table.columns %}
                                            {% set cell = row[column] %}
                                            <twig:Table:Cell class="align-top font-mono text-xs">
                                                {% if cell.multiline %}
                                                    <details>
                                                        <summary class="cursor-pointer text-muted-foreground">{{ 'debug.show'|trans(domain='dashboard') }}</summary>
                                                        <pre class="mt-2 max-h-96 overflow-auto rounded-md bg-muted p-3 whitespace-pre">{{ cell.text }}</pre>
                                                    </details>
                                                {% elseif cell.null %}
                                                    <span class="text-muted-foreground">{{ cell.text }}</span>
                                                {% else %}
                                                    <span class="break-all">{{ cell.text }}</span>
                                                {% endif %}
                                            </twig:Table:Cell>
                                        {% endfor %}
                                    </twig:Table:Row>
                                {% endfor %}
                            </twig:Table:Body>
                        </twig:Table>
                    {% endif %}
                </twig:Card:Content>
            </twig:Card>
        {% endfor %}
    </div>
{% endblock %}

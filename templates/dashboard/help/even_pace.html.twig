{# The help of a card of figures per day, week and month. #}
<div class="mt-2 gap-x-8 sm:columns-2">
    <twig:Dashboard:HelpSection icon="lucide:ruler" title="{{ 'help.section.what'|trans(domain='dashboard') }}">
        {{ 'help.even_pace.what'|trans(domain='dashboard')|nl2br }}
    </twig:Dashboard:HelpSection>
    <twig:Dashboard:HelpSection icon="lucide:scale" title="{{ 'help.section.use'|trans(domain='dashboard') }}">
        {{ 'help.even_pace.use'|trans(domain='dashboard')|nl2br }}
    </twig:Dashboard:HelpSection>
</div>

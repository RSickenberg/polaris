{# The help of a card of figures per day, week and month. #}
<div class="gap-x-3 sm:columns-2">
    <twig:Dashboard:HelpSection icon="lucide:target" title="{{ 'help.section.what'|trans(domain='dashboard') }}">
        {{ 'help.budget.what'|trans(domain='dashboard') }}
    </twig:Dashboard:HelpSection>
    <twig:Dashboard:HelpSection icon="lucide:wallet" title="{{ 'help.section.use'|trans(domain='dashboard') }}">
        {{ 'help.budget.use'|trans(domain='dashboard') }}
    </twig:Dashboard:HelpSection>
</div>

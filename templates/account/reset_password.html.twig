{% extends 'base.html.twig' %}

{% block title %}{{ 'page.reset.title'|trans(domain='account') }} · Polaris{% endblock %}

{# The bare layout, as nobody is signed in. #}
{% block body %}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm">{{ 'layout.skip'|trans(domain='shared') }}</a>
    <div class="flex min-h-svh flex-col">
        <header class="flex h-12 shrink-0 items-center justify-end gap-1 px-4">
            <twig:Shared:LocaleSwitcher />
            <twig:Shared:ThemeToggle />
        </header>
        <main id="main-content" class="flex flex-1 items-center justify-center p-4">
            <twig:Card class="w-full max-w-sm">
                <twig:Card:Header>
                    <twig:Card:Title><h1>{{ 'page.reset.title'|trans(domain='account') }}</h1></twig:Card:Title>
                    <twig:Card:Description>{{ 'page.reset.description'|trans(domain='account') }}</twig:Card:Description>
                </twig:Card:Header>
                <twig:Card:Content class="flex flex-col gap-4">
                    {{ form(form) }}
                    <a href="{{ path('account_login') }}" class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">{{ 'link.back_to_login'|trans(domain='account') }}</a>
                </twig:Card:Content>
            </twig:Card>
        </main>
    </div>
{% endblock %}

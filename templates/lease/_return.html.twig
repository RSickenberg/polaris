{# The car went back to the bank. Two dialogs confirm: the first takes the day, the second undoes the return. #}
{% set returnFailed = returnForm.vars.submitted and not returnForm.vars.valid %}

{# Like the projection above it: the title sits outside the card. #}
<section id="lease-return" class="mt-8">
<h2 class="mb-3 text-lg font-semibold">{{ 'return.title'|trans(domain='lease') }}</h2>
<twig:Card>
    <twig:Card:Content class="flex flex-col gap-4">
        {% if returnedOn is null %}
            <p class="text-sm text-muted-foreground text-pretty">{{ 'return.help'|trans(domain='lease') }}</p>
        {% else %}
            <p class="text-sm text-pretty" data-returned>{{ 'return.status'|trans({on: returnedOn}, 'lease') }}</p>
            <p class="text-sm text-muted-foreground text-pretty">{{ 'return.status_help'|trans(domain='lease') }}</p>
        {% endif %}

        <div class="flex flex-col gap-2 sm:flex-row">
            <twig:Dialog id="lease-return-dialog" :open="returnFailed">
                <twig:Dialog:Trigger>
                    <twig:Button {{ ...dialog_trigger_attrs }} type="button" variant="{{ returnedOn is null ? 'default' : 'outline' }}" class="w-full sm:w-auto">
                        {{ (returnedOn is null ? 'return.open' : 'return.change')|trans(domain='lease') }}
                    </twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content :showCloseButton="false">
                    {{ form_start(returnForm) }}
                        <twig:Dialog:Header>
                            <twig:Dialog:Title>{{ 'return.dialog.title'|trans(domain='lease') }}</twig:Dialog:Title>
                            <twig:Dialog:Description>{{ 'return.dialog.description'|trans(domain='lease') }}</twig:Dialog:Description>
                        </twig:Dialog:Header>
                        <div class="my-4">
                            {{ form_row(returnForm.returnedOn) }}
                        </div>
                        <twig:Dialog:Footer>
                            <twig:Dialog:Close>
                                <twig:Button {{ ...dialog_close_attrs }} type="button" variant="outline">{{ 'return.cancel'|trans(domain='lease') }}</twig:Button>
                            </twig:Dialog:Close>
                            {{ form_widget(returnForm.save) }}
                        </twig:Dialog:Footer>
                    {{ form_end(returnForm) }}
                </twig:Dialog:Content>
            </twig:Dialog>

            {% if returnedOn is not null %}
                <twig:Dialog id="lease-return-undo-dialog">
                    <twig:Dialog:Trigger>
                        <twig:Button {{ ...dialog_trigger_attrs }} type="button" variant="outline" class="w-full sm:w-auto">{{ 'return.undo'|trans(domain='lease') }}</twig:Button>
                    </twig:Dialog:Trigger>
                    <twig:Dialog:Content :showCloseButton="false">
                        <form method="post" action="{{ path('lease_return_undo', {id: vehicle.id.toBase32()}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('lease_return_undo') }}">
                            <twig:Dialog:Header>
                                <twig:Dialog:Title>{{ 'return.undo_dialog.title'|trans(domain='lease') }}</twig:Dialog:Title>
                                <twig:Dialog:Description>{{ 'return.undo_dialog.description'|trans(domain='lease') }}</twig:Dialog:Description>
                            </twig:Dialog:Header>
                            <twig:Dialog:Footer class="mt-4">
                                <twig:Dialog:Close>
                                    <twig:Button {{ ...dialog_close_attrs }} type="button" variant="outline">{{ 'return.cancel'|trans(domain='lease') }}</twig:Button>
                                </twig:Dialog:Close>
                                <twig:Button type="submit">{{ 'return.undo_confirm'|trans(domain='lease') }}</twig:Button>
                            </twig:Dialog:Footer>
                        </form>
                    </twig:Dialog:Content>
                </twig:Dialog>
            {% endif %}
        </div>
    </twig:Card:Content>
</twig:Card>
</section>
</section>

{% extends 'base.html.twig' %}

{% block title %}{{ 'page.settings.title'|trans(domain='lease') }} | {{ vehicle.name }}{% endblock %}

{% block main %}
    <twig:Shared:PageHeader title="{{ 'page.settings.title'|trans(domain='lease') }}" subject="{{ vehicle.name }}" />

    {# The form and, from the large breakpoint, the projection stacked on its right; on a phone one below the other. #}
    <div class="my-4 grid items-start gap-8 lg:grid-cols-[minmax(0,48rem)_20rem]">
        <div>
            {{ form(form) }}
        </div>

        <aside class="flex flex-col gap-6 lg:sticky lg:top-4">
            <twig:Card>
                <twig:Card:Header>
                    <twig:Card:Title><h2>{{ 'page.settings.assessment'|trans(domain='lease') }}</h2></twig:Card:Title>
                </twig:Card:Header>
                <twig:Card:Content>
                    {% if not hasContract %}
                        <p class="text-sm text-muted-foreground">{{ 'assessment.no_contract'|trans(domain='lease') }}</p>
                    {% elseif assessment is null %}
                        <p class="text-sm text-muted-foreground">{{ 'assessment.no_data'|trans(domain='lease') }}</p>
                    {% else %}
                        {% set level = assessment.riskLevel.value %}
                        {% set unit = 'unit.km'|trans(domain='shared') %}
                        <dl id="assessment" class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-3 text-sm">
                            <dt class="text-muted-foreground">{{ 'assessment.risk'|trans(domain='lease') }}</dt>
                            {# The level in words with its icon and color, like the alert of the dashboard. #}
                            <dd class="text-end" data-risk="{{ level }}">
                                <twig:Badge variant="outline" class="{{ {ok: 'border-risk-ok text-risk-ok', watch: 'border-risk-watch text-risk-watch', over: 'border-risk-over text-risk-over'}[level] }}">
                                    <twig:ux:icon name="{{ {ok: 'lucide:circle-check', watch: 'lucide:triangle-alert', over: 'lucide:circle-alert'}[level] }}" aria-hidden="true" data-icon="inline-start" />
                                    {{ ('risk.' ~ level)|trans(domain='lease') }}
                                </twig:Badge>
                            </dd>
                            <dt class="text-muted-foreground">{{ 'assessment.allowed_to_date'|trans(domain='lease') }}</dt>
                            <dd class="text-end font-medium">{{ assessment.projection.allowedToDate|km }}&nbsp;{{ unit }}</dd>
                            <dt class="text-muted-foreground">{{ 'assessment.projected_end'|trans(domain='lease') }}</dt>
                            <dd class="text-end font-medium">{{ assessment.projection.projectedAtEnd|km }}&nbsp;{{ unit }}</dd>
                            <dt class="text-muted-foreground">{{ 'assessment.projected_excess'|trans(domain='lease') }}</dt>
                            <dd class="text-end font-medium">{{ assessment.projectedExcess|km }}&nbsp;{{ unit }}</dd>
                        </dl>
                    {% endif %}
                </twig:Card:Content>
            </twig:Card>

            {# Under the projection, in the same sticky column. #}
            {% if hasContract %}
                {{ include('lease/_return.html.twig') }}
            {% endif %}
        </aside>
    </div>
{% endblock %}

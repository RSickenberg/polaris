{# The hours the owner usually does not drive: how the odometer is read between two readings. #}
<twig:Card id="lease-driving-hours">
    <twig:Card:Header>
        <twig:Card:Title><h2>{{ 'hours.title'|trans(domain='lease') }}</h2></twig:Card:Title>
    </twig:Card:Header>
    <twig:Card:Content class="flex flex-col gap-4">
        <div class="flex flex-col gap-3 text-sm text-pretty text-muted-foreground" data-hours-help>
            <p class="font-medium text-foreground">{{ 'hours.help.question'|trans(domain='lease') }}</p>
            <p>{{ 'hours.help.how'|trans(domain='lease')|nl2br }}</p>
            <p>{{ 'hours.help.empty'|trans(domain='lease') }}</p>
            <p class="font-semibold text-foreground">{{ 'hours.help.scope'|trans(domain='lease') }}</p>
        </div>
        {{ form(hoursForm) }}
    </twig:Card:Content>
</twig:Card>

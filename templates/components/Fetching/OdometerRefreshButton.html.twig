{% set outcome = this.outcome %}
{% set until = this.retryAt %}
{% set polling = this.polling %}
{# The toast: one element per click and result, so that a poll that shows the same result does not announce it again. #}
{% set toast = null %}
{% if until is not null %}
    {% set toast = {id: 'limited-' ~ this.clicks, variant: 'warning', message: 'limited.message'|trans({time: until|format_time('short', timezone=this.timeZone), zone: until|format_datetime(pattern: 'zzz', timezone: this.timeZone)}, 'fetching')} %}
{% elseif outcome is not null and (outcome.value != 'queued' or not polling) %}
    {% set key = outcome.value == 'queued' ? 'queued_late' : outcome.value %}
    {% set toast = {id: 'result-' ~ this.clicks, variant: outcome.toastVariant, message: ('outcome.' ~ key)|trans(domain='fetching')} %}
{% endif %}
<div
    {{ attributes.defaults({class: 'flex flex-col items-start gap-1.5'}) }}
    {%- if polling %} data-poll="delay(2000)|$render"{% endif %}
>
    <twig:Button
        variant="outline"
        size="sm"
        class="w-full sm:w-auto"
        data-action="live#action"
        data-live-action-param="refresh"
        :disabled="polling"
    >
        <twig:ux:icon name="lucide:refresh-cw" aria-hidden="true" data-icon="inline-start" data-loading="addClass(animate-spin)" class="{{ polling ? 'animate-spin' }}" />
        {{ 'button.label'|trans(domain='fetching') }}
    </twig:Button>
    <p class="sr-only" role="status">
        {%- if polling -%}{{- 'outcome.queued'|trans(domain='fetching') -}}{%- endif -%}
    </p>
    {% if toast is not null %}
        <twig:Shared:ToastAnnounce :id="toast.id" :variant="toast.variant" :message="toast.message" />
    {% endif %}
</div>

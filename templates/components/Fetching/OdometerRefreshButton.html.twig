{% set outcome = this.outcome %}
{% set polling = this.polling %}
{% set toast = this.toast %}
{# Inside a child component tag, `this` is the child: anything taken from this component is set before. #}
{% set dialogKey = this.wakeDialogKey %}
{% set wakeCost = this.wakeCost|format_currency(this.wakeCurrency) %}
{% set toastMessage = null %}
{% if toast is not null %}
    {% set toastParameters = toast.at is null ? {} : {
        time: toast.at|format_time('short', timezone=this.timeZone),
        zone: toast.at|format_datetime(pattern: 'zzz', timezone: this.timeZone),
    } %}
    {% set toastMessage = toast.key|trans(toastParameters, 'fetching') %}
{% endif %}
<div
    {{ attributes.defaults({class: 'flex flex-col items-start gap-1.5'}) }}
    {%- if polling %} data-poll="delay(2000)|$render"{% endif %}
>
    <twig:Button
        variant="outline"
        size="sm"
        class="w-full sm:w-auto"
        data-action="live#action"
        data-live-action-param="refresh"
        :disabled="polling"
    >
        <twig:ux:icon name="lucide:refresh-cw" aria-hidden="true" data-icon="inline-start" data-loading="addClass(animate-spin)" class="{{ polling ? 'animate-spin' }}" />
        {{ 'button.label'|trans(domain='fetching') }}
    </twig:Button>
    <p class="sr-only" role="status">
        {%- if polling -%}{{- ('outcome.' ~ (outcome is null ? 'queued' : outcome.value))|trans(domain='fetching') -}}{%- endif -%}
    </p>
    {% if this.needsReconnectToWake %}
        <a
            href="{{ path('tesla_reauthorize') }}"
            data-turbo="false"
            data-wake-reconnect
            class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground"
        >{{ 'wake.reconnect'|trans(domain='fetching') }}</a>
    {% endif %}
    {% if this.wakeDialogOpen %}
        <twig:Dialog id="wake-{{ this.vehicleId }}" :open="true" data-wake-dialog>
            <twig:Dialog:Content :showCloseButton="false">
                <twig:Dialog:Header>
                    <twig:Dialog:Title>{{ (dialogKey ~ '.title')|trans(domain='fetching') }}</twig:Dialog:Title>
                    <twig:Dialog:Description>{{ (dialogKey ~ '.description')|trans({cost: wakeCost}, 'fetching')|nl2br }}</twig:Dialog:Description>
                </twig:Dialog:Header>
                <twig:Dialog:Footer>
                    <twig:Button type="button" variant="outline" data-action="live#action" data-live-action-param="declineWake">
                        {{ 'wake.dialog.decline'|trans(domain='fetching') }}
                    </twig:Button>
                    <twig:Button type="button" data-action="live#action" data-live-action-param="wake">
                        {{ 'wake.dialog.confirm'|trans(domain='fetching') }}
                    </twig:Button>
                </twig:Dialog:Footer>
            </twig:Dialog:Content>
        </twig:Dialog>
    {% endif %}
    {% if outcome is not null and outcome.movesFigures %}
        {# New figures: the dashboard refreshes itself once, one element per click so that a poll showing the same result does not do it again. #}
        <div hidden id="figures-{{ this.clicks }}" data-controller="dashboard-refresh"></div>
    {% endif %}
    {% if toast is not null %}
        <twig:Shared:ToastAnnounce :id="toast.id" :variant="toast.variant.value" :message="toastMessage" />
    {% endif %}
</div>

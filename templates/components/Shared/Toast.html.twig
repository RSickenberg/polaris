{%- props
    ## 'success'|'warning'|'info'|'danger' The look and the icon of the toast. A danger toast stays until it is dismissed.
    variant = 'info',
    ## string The message, already translated; empty in the empty toasts that the toast region clones.
    message = ''
-%}
{# The tones of app.css, shared with the risk alert and the empty states; red through the destructive Alert. #}
{%- set tone = {
    success: 'border-success bg-success-surface text-success-foreground',
    warning: 'border-warning bg-warning-surface text-warning-foreground',
    info: 'border-info bg-info-surface text-info-foreground',
    danger: '',
}[variant] -%}
{# Set here: inside the Alert tag, `variant` is the one of the Alert. #}
{%- set icon = {success: 'lucide:circle-check', warning: 'lucide:triangle-alert', info: 'lucide:info', danger: 'lucide:circle-alert'}[variant] -%}
{%- set delay = 'danger' == variant ? 0 : 6000 -%}
{%- set alertVariant = 'danger' == variant ? 'destructive' : 'default' -%}
<twig:Alert
    variant="{{ alertVariant }}"
    class="pointer-events-auto items-center gap-x-3 rounded-xl px-4 py-4 pe-12 shadow-lg *:[svg]:row-span-1 *:[svg]:translate-y-0 *:[svg]:self-center {{ tone }}"
    data-flash="{{ variant }}"
    data-controller="toast"
    data-toast-delay-value="{{ delay }}"
    data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume"
>
    <twig:ux:icon name="{{ icon }}" aria-hidden="true" class="size-5" />
    <twig:Alert:Title data-toast-message class="col-start-2 text-sm leading-snug whitespace-pre-line">{{ message }}</twig:Alert:Title>
    <twig:Alert:Action class="absolute end-3 top-1/2 -translate-y-1/2">
        <twig:Button variant="ghost" size="icon-xs" data-action="toast#dismiss" aria-label="{{ 'ui.close'|trans(domain='shared') }}">
            <twig:ux:icon name="lucide:x" aria-hidden="true" />
        </twig:Button>
    </twig:Alert:Action>
</twig:Alert>

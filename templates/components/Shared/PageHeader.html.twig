{%- props
    ## string The title of the page (the h1), already translated.
    title,
    ## string|null What the page is about, shown after the title in a lighter tone: the name of the vehicle.
    subject = null
-%}
{# The header of every page that extends base.html.twig: the h1, and the actions of the page (the content of the tag) on its right from the small breakpoint, below it on a phone. #}
{% set actions %}{% block content %}{% endblock %}{% endset %}
<div {{ attributes.defaults({class: 'flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4'}) }}>
    <h1 class="text-2xl font-semibold tracking-tight">
        {{- title -}}
        {%- if subject is not null %} <span class="font-normal text-muted-foreground">| {{ subject }}</span>{% endif -%}
    </h1>
    {%- if actions|trim is not empty %}
        {{ actions }}
    {%- endif %}
</div>

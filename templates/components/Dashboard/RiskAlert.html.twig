{%- props
    ## 'ok'|'watch'|'over' The risk level of the lease.
    level
-%}
{# The level is told by the icon and the title as well as by the color (tokens --risk-* and the tones of app.css). The message is the content of the tag; it takes the color of the title, its bold figures included. #}
{# A block cannot sit inside a <twig:...> tag, so the message is rendered here and placed below. #}
{% set message %}{% block content %}{% endblock %}{% endset %}
{% set icons = {ok: 'lucide:circle-check', watch: 'lucide:triangle-alert', over: 'lucide:circle-alert'} %}
<twig:Alert
    :variant="'over' == level ? 'destructive' : 'default'"
    data-risk="{{ level }}"
    class="{{ {
        ok: 'border-risk-ok bg-success-surface text-success-foreground *:data-[slot=alert-description]:text-success-foreground',
        watch: 'border-risk-watch bg-warning-surface text-warning-foreground *:data-[slot=alert-description]:text-warning-foreground',
        over: 'border-risk-over bg-danger-surface text-danger-foreground *:data-[slot=alert-description]:text-danger-foreground',
    }[level] ?? '' }}"
    {{ ...attributes }}
>
    <twig:ux:icon :name="icons[level]" aria-hidden="true" />
    <twig:Alert:Title>{{ ('risk.' ~ level)|trans(domain='lease') }}</twig:Alert:Title>
    <twig:Alert:Description>{{ message }}</twig:Alert:Description>
</twig:Alert>

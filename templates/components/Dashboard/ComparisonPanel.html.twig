{%- props
    ## string The name of the panel, used by the tests and the styles (data-comparison).
    key,
    ## string The translated title of the panel.
    title,
    ## string The translated sentence that says what is compared.
    basis,
    ## string The translated header of the column with the two figures that are compared.
    figuresLabel,
    ## list<\Polaris\Dashboard\Service\Dto\ComparisonRow> The four periods, today first.
    rows
-%}
{# A card with one row per period: what happened against what the snapshot of that day expected. A positive difference is more than expected. The figures are formatted by the translations (ICU), so each locale groups and signs them its own way; a French number groups its thousands with a narrow no-break space, which looks like no space at this size: a regular no-break space reads better. #}
{% set unit = 'unit.km'|trans(domain='shared') %}
<twig:Card data-comparison="{{ key }}" {{ ...attributes }}>
    <twig:Card:Header>
        <twig:Card:Title><h2>{{ title }}</h2></twig:Card:Title>
        <twig:Card:Description>{{ basis }}</twig:Card:Description>
    </twig:Card:Header>
    <twig:Card:Content class="mt-auto">
        <twig:Table>
            <twig:Table:Header>
                <twig:Table:Row>
                    <twig:Table:Head class="ps-0 whitespace-normal">{{ 'compare.column.period'|trans(domain='dashboard') }}</twig:Table:Head>
                    <twig:Table:Head class="whitespace-normal text-end">{{ figuresLabel }}</twig:Table:Head>
                    <twig:Table:Head class="pe-0 whitespace-normal text-end">{{ 'compare.column.difference'|trans(domain='dashboard') }}</twig:Table:Head>
                </twig:Table:Row>
            </twig:Table:Header>
            <twig:Table:Body>
                {% for row in rows %}
                    <twig:Table:Row data-period="{{ row.period.value }}">
                        <twig:Table:Cell class="ps-0 whitespace-normal">{{ ('compare.period.' ~ row.period.value)|trans(domain='dashboard') }}</twig:Table:Cell>
                        {% if row.figures is null %}
                            <twig:Table:Cell colspan="2" class="pe-0 whitespace-normal text-end text-muted-foreground" data-no-history>{{ 'compare.no_history'|trans(domain='dashboard') }}</twig:Table:Cell>
                        {% else %}
                            {% set figures = row.figures %}
                            {% set direction = figures.delta.isNegative ? 'negative' : (figures.delta.metres > 0 ? 'positive' : 'zero') %}
                            <twig:Table:Cell class="whitespace-normal text-end font-mono" data-figure="figures">{{ 'compare.figures'|trans({actual: figures.actual.metres / 1000, expected: figures.expected.metres / 1000, unit: unit}, 'dashboard')|replace({" ": " "}) }}</twig:Table:Cell>
                            <twig:Table:Cell class="pe-0 whitespace-normal text-end" data-figure="delta">
                                <span class="font-mono">{{ 'compare.delta'|trans({sign: direction, km: figures.delta.absolute.metres / 1000, unit: unit}, 'dashboard')|replace({" ": " "}) }}</span>
                                {% if figures.ratio is not null %}
                                    <span class="block text-xs text-muted-foreground" data-figure="ratio">{{ 'compare.ratio'|trans({sign: direction, share: figures.ratio < 0 ? -figures.ratio : figures.ratio}, 'dashboard') }}</span>
                                {% endif %}
                            </twig:Table:Cell>
                        {% endif %}
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    </twig:Card:Content>
</twig:Card>

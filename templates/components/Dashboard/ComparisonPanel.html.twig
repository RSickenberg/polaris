{%- props
    ## string The name of the panel, used by the tests and the styles (data-comparison).
    key,
    ## string The translated title of the panel.
    title,
    ## string The translated sentence that says which two figures are compared and against what.
    basis,
    ## list<\Polaris\Dashboard\Service\Dto\ComparisonRow> The four periods, today first.
    rows,
    ## string|null The translated explanation of the panel, shown in a dialog behind an info button.
    help = null
-%}
{# A card with one row per period: the period with the two figures under it (what happened, what was expected), and the gap on the right, as large as the period. A positive gap is more than expected: the gap is a red pill, and a gap of zero or less a green one. Only the digits are monospaced. Before any period has history (the first days after deploy), one line says so instead of four empty rows. #}
{% set withHistory = rows|filter(row => row.figures is not null or row.awaitingReading)|length > 0 %}
{% set unit = 'unit.km'|trans(domain='shared') %}
<twig:Card data-comparison="{{ key }}" {{ ...attributes }}>
    <twig:Card:Header>
        <twig:Card:Title><h2>{{ title }}</h2></twig:Card:Title>
        <twig:Card:Description>{{ basis }}</twig:Card:Description>
        {% if help is not null %}
            <twig:Dashboard:CardHelp name="compare-{{ key }}" :title="title" :text="help" />
        {% endif %}
    </twig:Card:Header>
    <twig:Card:Content>
        {% if not withHistory %}
            <p class="text-sm text-muted-foreground" data-no-history>{{ 'compare.no_history_yet'|trans(domain='dashboard') }}</p>
        {% else %}
            {# The table sits in the card as a rounded, inset block: border, soft background and a light shadow give it depth. #}
            <div class="overflow-hidden rounded-xl border border-border bg-muted/30 shadow-xs">
                <twig:Table>
                    <twig:Table:Header>
                        {# The header row is not a row to point at: no hover colour (the kit row has one). #}
                        <twig:Table:Row class="bg-muted/50 hover:bg-muted/50!">
                            <twig:Table:Head class="ps-4 pe-2 whitespace-normal">{{ 'compare.column.period'|trans(domain='dashboard') }}</twig:Table:Head>
                            <twig:Table:Head class="ps-2 pe-4 whitespace-normal text-end">{{ 'compare.column.difference'|trans(domain='dashboard') }}</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        {% for row in rows %}
                            {% set figures = row.figures %}
                            <twig:Table:Row data-period="{{ row.period.value }}">
                                <twig:Table:Cell class="py-3 ps-4 pe-2 whitespace-normal">
                                    {# "Today" without a snapshot of its own day starts at the midnight of the latest earlier one. #}
                                    <div class="flex flex-wrap items-center gap-x-2">
                                        {% if row.fallbackDays > 0 %}
                                            <span data-fallback-days="{{ row.fallbackDays }}">{{ 'compare.period.since_days'|trans({count: row.fallbackDays}, domain='dashboard') }}</span>
                                        {% else %}
                                            <span{{ figures is null ? ' class="text-muted-foreground"' : '' }}>{{ ('compare.period.' ~ row.period.value)|trans(domain='dashboard') }}</span>
                                        {% endif %}
                                        {# Rebuilt on the fly: the midnight snapshot of the day is not saved yet. A pulsing dot and the words, never colour alone. #}
                                        {% if row.live and figures is not null %}
                                            <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground" data-live title="{{ 'compare.live_hint'|trans(domain='dashboard') }}">
                                                <span class="relative flex size-2" aria-hidden="true">
                                                    <span class="absolute inline-flex size-full rounded-full bg-info opacity-75 motion-safe:animate-ping"></span>
                                                    <span class="relative inline-flex size-2 rounded-full bg-info"></span>
                                                </span>
                                                {{ 'compare.live'|trans(domain='dashboard') }}
                                            </span>
                                        {% endif %}
                                    </div>
                                    {% if figures is not null %}
                                        <span class="mt-1 block text-xs text-muted-foreground" data-figure="figures">
                                            {%- set actual = figures.actual|km -%}
                                            {%- set expected = figures.expected|km -%}
                                            <span class="font-mono">{{ actual }}</span> / <span class="font-mono">{{ expected }}</span> {{ unit }}
                                        </span>
                                    {% endif %}
                                </twig:Table:Cell>
                                {% if row.awaitingReading %}
                                    <twig:Table:Cell class="py-3 ps-2 pe-4 whitespace-normal text-end text-sm text-muted-foreground/70" data-awaiting-reading>{{ 'compare.no_reading_today'|trans(domain='dashboard') }}</twig:Table:Cell>
                                {% elseif figures is null %}
                                    <twig:Table:Cell class="py-3 ps-2 pe-4 whitespace-normal text-end text-sm text-muted-foreground/70" data-no-history>{{ 'compare.no_history'|trans(domain='dashboard') }}</twig:Table:Cell>
                                {% else %}
                                    {% set sign = '' %}
                                    {% if figures.delta.isNegative %}
                                        {% set sign = '−' %}
                                    {% elseif figures.delta.metres > 0 %}
                                        {% set sign = '+' %}
                                    {% endif %}
                                    {# Every panel compares a distance driven or projected: more than expected is bad news (red), the same or less is good news (green). #}
                                    {% set good = figures.delta.metres <= 0 %}
                                    {% set tone = good ? 'border-success/30 bg-success-surface text-success-foreground' : 'border-danger/30 bg-danger-surface text-danger-foreground' %}
                                    {# The arrow says it too, so the colour is never alone: down is under the expectation, up is over it, a dash is on it. #}
                                    {% set trend = 'lucide:minus' %}
                                    {% if figures.delta.isNegative %}
                                        {% set trend = 'lucide:trending-down' %}
                                    {% elseif figures.delta.metres > 0 %}
                                        {% set trend = 'lucide:trending-up' %}
                                    {% endif %}
                                    <twig:Table:Cell class="py-3 ps-2 pe-4 whitespace-normal text-end">
                                        <twig:Badge
                                            variant="outline"
                                            class="h-7 gap-1.5 px-3 text-sm font-semibold {{ tone }}"
                                        >
                                            <twig:ux:icon :name="trend" aria-hidden="true" />
                                            <span data-figure="delta" data-tone="{{ good ? 'good' : 'bad' }}"><span class="font-mono">{{ sign }}{{ figures.delta.absolute|km }}</span> {{ unit }}</span>
                                            {# The gap as a share of what was expected, after a thin vertical rule. #}
                                            {% if figures.ratio is not null %}
                                                <span class="h-3.5 w-px bg-current opacity-30" aria-hidden="true"></span>
                                                <span class="font-mono font-medium opacity-80" data-figure="ratio">{{ sign }}{{ figures.ratio|abs|percent }}</span>
                                            {% endif %}
                                        </twig:Badge>
                                    </twig:Table:Cell>
                                {% endif %}
                            </twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </div>
        {% endif %}
    </twig:Card:Content>
</twig:Card>

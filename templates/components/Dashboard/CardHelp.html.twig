{%- props
    ## string Unique name of the help, used for the dialog id (data-help).
    name,
    ## string The translated title of the card the help is about.
    title,
    ## string The translated explanation; a written \n becomes a line break.
    text
-%}
{# The info button at the top right of a card header, which opens a dialog that explains the card. #}
<twig:Card:Action>
    <twig:Dialog :id="'help-' ~ name">
        <twig:Dialog:Trigger>
            <twig:Button
                {{ ...dialog_trigger_attrs }}
                type="button"
                variant="ghost"
                size="icon-sm"
                class="text-muted-foreground"
                data-help="{{ name }}"
                aria-label="{{ 'help.open'|trans({'%title%': title}, 'dashboard') }}"
            >
                <twig:ux:icon name="lucide:info" aria-hidden="true" />
            </twig:Button>
        </twig:Dialog:Trigger>
        <twig:Dialog:Content>
            <twig:Dialog:Header>
                <twig:Dialog:Title>{{ title }}</twig:Dialog:Title>
                <twig:Dialog:Description class="text-pretty">{{ text|replace({'\\n': "\n"})|nl2br }}</twig:Dialog:Description>
            </twig:Dialog:Header>
        </twig:Dialog:Content>
    </twig:Dialog>
</twig:Card:Action>

{%- props
    ## string The translated name of the example period.
    period,
    ## string The formatted first figure (what happened).
    actual,
    ## string The formatted second figure (what was expected).
    expected,
    ## string The formatted gap, with its sign.
    gap,
    ## string The formatted gap as a share of the second figure, with its sign.
    share,
    ## string The translated label of the first figure.
    actualLabel,
    ## string The translated label of the second figure.
    expectedLabel,
    ## string The translated label of the gap.
    gapLabel
-%}
{% set unit = 'unit.km'|trans(domain='shared') %}
{# An example row of the panel, drawn like the real one, with a numbered mark on each part and the same numbers in the list under it. #}
{% macro mark(number) %}<span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-foreground text-xs font-semibold text-background" aria-hidden="true">{{ number }}</span>{% endmacro %}
<div class="rounded-xl border bg-card p-4 shadow-xs" data-help-anatomy>
    <div class="flex items-center justify-between gap-4 rounded-md border bg-background px-4 py-3" aria-hidden="true">
        <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2 text-sm">{{ _self.mark(1) }} {{ period }}</span>
            <span class="flex items-center gap-2 text-xs text-muted-foreground">
                {{ _self.mark(2) }}
                <span><span class="font-mono">{{ actual }}</span> / <span class="font-mono">{{ expected }}</span> {{ unit }}</span>
            </span>
        </div>
        <div class="flex items-center gap-2">
            <twig:Badge variant="outline" class="h-7 gap-1.5 border-danger/30 bg-danger-surface px-3 text-sm font-semibold text-danger-foreground">
                <twig:ux:icon name="lucide:trending-up" />
                <span><span class="font-mono">{{ gap }}</span> {{ unit }}</span>
                <span class="h-3.5 w-px bg-current opacity-30"></span>
                <span class="font-mono font-medium opacity-80">{{ share }}</span>
            </twig:Badge>
            {{ _self.mark(3) }}
        </div>
    </div>
    <ol class="mt-4 flex flex-col gap-2.5 text-sm text-muted-foreground">
        <li class="flex items-center gap-2.5">{{ _self.mark(1) }} <span>{{ 'help.anatomy.period'|trans(domain='dashboard') }}</span></li>
        <li class="flex items-start gap-2.5">{{ _self.mark(2) }} <span class="flex flex-col"><span class="font-medium text-foreground">{{ actualLabel }}</span><span>{{ expectedLabel }}</span></span></li>
        <li class="flex items-center gap-2.5">{{ _self.mark(3) }} <span>{{ gapLabel }}</span></li>
    </ol>
</div>

{# The toast region: the success and error flash messages, once each, and the toasts that scripts ask for. #}
{# The empty toasts scripts clone are handed over as strings, not as <template>s: nothing inert sits in the page. #}
{% set success %}<twig:Shared:Toast variant="success" />{% endset %}
{% set info %}<twig:Shared:Toast variant="info" />{% endset %}
{% set error %}<twig:Shared:Toast variant="error" />{% endset %}
<div
    class="pointer-events-none fixed bottom-4 end-4 z-50 flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-2"
    aria-live="polite"
    data-controller="toast-region"
    data-toast-region-toasts-value="{{ {success: success|raw, info: info|raw, error: error|raw}|json_encode|e('html_attr') }}"
>
    {% for message in app.flashes('success') %}
        <twig:Shared:Toast variant="success" :message="message" />
    {% endfor %}
    {% for message in app.flashes('error') %}
        <twig:Shared:Toast variant="error" :message="message" />
    {% endfor %}
</div>

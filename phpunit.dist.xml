<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <ini name="date.timezone" value="UTC"/>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <!-- Every functional test boots its own kernel: the suite no longer fits in the 128M default. -->
        <ini name="memory_limit" value="512M"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="KERNEL_CLASS" value="Polaris\Kernel"/>
        <!--
            The tests are about the shipped defaults of .env. Compose loads .env.local into the php container as real
            environment variables, which win over .env and .env.test: force the values the tests rely on, whatever the
            install of the developer set there.
        -->
        <env name="POLARIS_MANUAL_REFRESH_LIMIT" value="1" force="true"/>
        <env name="POLARIS_KEY_HOSTING" value="polaris" force="true"/>
        <env name="POLARIS_KEY_HOSTING_DIR" value="" force="true"/>
        <env name="POLARIS_KEY_HOSTING_URL" value="" force="true"/>
        <env name="POLARIS_TESLA_REDIRECT_URI" value="" force="true"/>
        <env name="POLARIS_TESLA_REFRESH_MARGIN" value="600" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="Polaris">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <extensions>
        <!-- Each test runs in a transaction that is rolled back afterwards. -->
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

{
    "name": "rsickenberg/polaris",
    "description": "Track a Tesla's odometer against the lease allowance and project the mileage at lease end. Self-hostable Symfony application.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Romain Sickenberg",
            "homepage": "https://github.com/RSickenberg"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "carbonphp/carbon-doctrine-types": "^3.2",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "nesbot/carbon": "^3.14",
        "symfony/clock": "*",
        "symfony/console": "*",
        "symfony/dotenv": "*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "*",
        "symfony/runtime": "*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Polaris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polaris\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php bin/phpunit",
        "phpstan": [
            "@php bin/console cache:warmup --env=dev --no-interaction",
            "phpstan analyse --no-progress --no-interaction --memory-limit=1G"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "cs:fix": "php-cs-fixer fix --no-interaction",
        "deptrac": "deptrac analyse --no-progress --no-interaction --report-uncovered --fail-on-uncovered",
        "ci": [
            "@cs",
            "@phpstan",
            "@deptrac",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "phpstan": "Warm up the dev container, then run PHPStan (level max)",
        "cs": "Check the coding standard (PHP-CS-Fixer dry run)",
        "cs:fix": "Fix the coding standard (PHP-CS-Fixer)",
        "deptrac": "Check the module boundaries of ADR 0001 (Deptrac)",
        "ci": "Run every check, as CI does"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

{
    "name": "rsickenberg/polaris",
    "description": "Track a Tesla's odometer against the lease allowance and project the mileage at lease end. Self-hostable Symfony application.",
    "type": "project",
    "license": "PolyForm-Noncommercial-1.0.0",
    "authors": [
        {
            "name": "Romain Sickenberg",
            "homepage": "https://github.com/RSickenberg"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "carbonphp/carbon-doctrine-types": "^3.2",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "dragonmantank/cron-expression": "^3.6",
        "nesbot/carbon": "^3.15",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/clock": "*",
        "symfony/console": "*",
        "symfony/dotenv": "*",
        "symfony/filesystem": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/runtime": "*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-icons": "^3.6",
        "symfony/ux-live-component": "^3.6",
        "symfony/ux-turbo": "^3.6",
        "symfony/ux-twig-component": "^3.6",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.3.0",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.24.0",
        "twig/intl-extra": "^3.30"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "deptrac/deptrac": "^4.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.4.3",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/ux-toolkit": "^3.6",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Polaris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polaris\\Fixtures\\": "fixtures/",
            "Polaris\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php bin/phpunit",
        "phpstan": [
            "@php bin/console cache:warmup --env=dev --no-interaction",
            "phpstan analyse --no-progress --no-interaction --memory-limit=1G"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "cs:fix": "php-cs-fixer fix --no-interaction",
        "deptrac": "deptrac analyse --no-progress --no-interaction --report-uncovered --fail-on-uncovered",
        "translations": [
            "@php bin/console lint:xliff translations --no-interaction",
            "@php bin/console lint:translations --no-interaction",
            "@php bin/console debug:translation fr --only-missing --no-interaction"
        ],
        "ci": [
            "@cs",
            "@phpstan",
            "@deptrac",
            "@translations",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "phpstan": "Warm up the dev container, then run PHPStan (level max)",
        "cs": "Check the coding standard (PHP-CS-Fixer dry run)",
        "cs:fix": "Fix the coding standard (PHP-CS-Fixer)",
        "deptrac": "Check the module boundaries of ADR 0001 (Deptrac)",
        "translations": "Lint the XLIFF files and fail on a missing French key",
        "ci": "Run every check, as CI does"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

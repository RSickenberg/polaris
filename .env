# Committed defaults for the self-hosted app.
# Override them in .env.local (not committed) or with real environment variables.

###> symfony/framework-bundle ###
APP_ENV=dev
# Never commit a secret here. Set it in .env.local (not committed) or as an environment variable:
#   php -r "echo 'APP_SECRET='.bin2hex(random_bytes(16)).PHP_EOL;" >> .env.local
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# Also the public address of the app: the links in emails are built from it, never from the request host.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# No secret here: ${POSTGRES_PASSWORD} is resolved from .env.local (see .env.example)
# or from the environment. Generate it with "openssl rand -hex 16" so it needs no URL
# encoding. The host "database" is the Docker Compose service.
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://polaris:${POSTGRES_PASSWORD}@database:5432/polaris?charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# The development containers set MAILER_DSN to the Mailpit service (UI on http://localhost:8025).
MAILER_DSN=null://null
# The sender of the emails Polaris sends (password reset).
MAILER_FROM=polaris@localhost
###< symfony/mailer ###

###> polaris/tesla ###
# Where Tesla finds the public key: "polaris" (this app serves /.well-known/appspecific/com.tesla.3p.public-key.pem)
# or "external", where the key lives on a static site and you say where with one of:
# POLARIS_KEY_HOSTING_DIR (keygen writes the file into this local clone of the site) or
# POLARIS_KEY_HOSTING_URL (the https URL of the PEM file, which you publish yourself).
POLARIS_KEY_HOSTING=polaris
POLARIS_KEY_HOSTING_DIR=
POLARIS_KEY_HOSTING_URL=
# The OAuth redirect URI, sent unchanged to Tesla and listed in the allowed redirect URIs of your Tesla app.
# Empty: DEFAULT_URI followed by /tesla/callback.
POLARIS_TESLA_REDIRECT_URI=
# Seconds before the access token expires at which Polaris refreshes it.
POLARIS_TESLA_REFRESH_MARGIN=600
# 1 limits the manual refresh of a vehicle to once per hour (every read is billed by Tesla), 0 lifts the limit.
POLARIS_MANUAL_REFRESH_LIMIT=1
###< polaris/tesla ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
# The Docker Compose services set it to the Redis service, so that the PHP processes share their locks.
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/messenger ###
# The Docker Compose services set it to the Redis service. The transports (async, tesla, failed) are streams of this server.
MESSENGER_TRANSPORT_DSN=redis://localhost:6379
###< symfony/messenger ###

###> polaris/error-reporting ###
# Nothing is sent to Sentry unless the owner of the instance opts in: "off", "maintainer" (the maintainer's Sentry
# project) or "custom" (your own, with SENTRY_DSN). See "Error reporting" in the README.
POLARIS_ERROR_REPORTING=off
SENTRY_DSN=
# Share of the requests and messages traced, from 0 to 1. Empty: 0.05.
SENTRY_TRACES_SAMPLE_RATE=
###< polaris/error-reporting ###

###> polaris/proxy ###
TRUSTED_PROXIES=
###< polaris/proxy ###

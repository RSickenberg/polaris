# Committed defaults for the self-hosted app.
# Override them in .env.local (not committed) or with real environment variables.

###> symfony/framework-bundle ###
APP_ENV=dev
# Never commit a secret here. Set it in .env.local (not committed) or as an environment variable:
#   php -r "echo 'APP_SECRET='.bin2hex(random_bytes(16)).PHP_EOL;" >> .env.local
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# Also the public address of the app: the links in emails are built from it, never from the request host.
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# No secret here: ${POSTGRES_PASSWORD} is resolved from .env.local (see .env.example)
# or from the environment. Generate it with "openssl rand -hex 16" so it needs no URL
# encoding. The host "database" is the Docker Compose service.
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://polaris:${POSTGRES_PASSWORD}@database:5432/polaris?charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# The development containers set MAILER_DSN to the Mailpit service (UI on http://localhost:8025).
MAILER_DSN=null://null
# The sender of the emails Polaris sends (password reset).
MAILER_FROM=polaris@localhost
###< symfony/mailer ###

###> polaris/tesla ###
# Where Tesla finds the public key: "polaris" (this app serves /.well-known/appspecific/com.tesla.3p.public-key.pem)
# or "external" (keygen writes the file into POLARIS_KEY_HOSTING_DIR, a local clone of a static site).
POLARIS_KEY_HOSTING=polaris
POLARIS_KEY_HOSTING_DIR=
###< polaris/tesla ###

# Committed defaults for the self-hosted app.
# Override them in .env.local (not committed) or with real environment variables.

###> symfony/framework-bundle ###
APP_ENV=dev
# Never commit a secret here. Set it in .env.local (not committed) or as an environment variable:
#   php -r "echo 'APP_SECRET='.bin2hex(random_bytes(16)).PHP_EOL;" >> .env.local
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

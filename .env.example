# Template for .env.local, which is git-ignored and never committed.
#   cp .env.example .env.local
# Then fill every value below; generate each secret with: openssl rand -hex 16
# Symfony reads .env.local, and every Docker Compose service loads it through env_file.
# Keep this file in sync: any new variable that must be set per install goes here, empty.

###> symfony/framework-bundle ###
APP_SECRET=
###< symfony/framework-bundle ###

###> postgres ###
POSTGRES_PASSWORD=
###< postgres ###

###> symfony/mailer ###
# Per install, in .env.local: where to send emails (MAILER_DSN, for example smtp://user:pass@smtp.example.com:587),
# who they come from (MAILER_FROM) and the public address of the app (DEFAULT_URI, for example https://polaris.example.com).
# Without a real MAILER_DSN, no email leaves the app and the password reset cannot work.
MAILER_DSN=
MAILER_FROM=
DEFAULT_URI=
###< symfony/mailer ###

###> polaris/encryption ###
# Encrypts the Tesla private key (and later the other secrets) in the database. 32 random bytes in base64:
#   openssl rand -base64 32
# Back it up: without it the stored secrets cannot be read. It can also be a Symfony secret (bin/console secrets:set POLARIS_ENCRYPTION_KEY).
POLARIS_ENCRYPTION_KEY=
###< polaris/encryption ###

###> polaris/error-reporting ###
# Optional error reporting to Sentry, off by default. See "Error reporting" in the README for what is sent.
#   off         nothing is sent (the default, also when empty)
#   maintainer  to the Sentry project of the Polaris maintainer
#   custom      to your own Sentry project, with SENTRY_DSN
POLARIS_ERROR_REPORTING=
# Only with POLARIS_ERROR_REPORTING=custom: the DSN of your own Sentry project.
SENTRY_DSN=
# Share of the requests and messages traced, from 0 to 1 (empty: 0.05; 0 sends no trace).
SENTRY_TRACES_SAMPLE_RATE=
###< polaris/error-reporting ###

###> polaris/proxy ###
# Only behind a reverse proxy: its address(es), comma-separated (e.g. 172.18.0.0/16). Empty: none is trusted.
TRUSTED_PROXIES=
###< polaris/proxy ###

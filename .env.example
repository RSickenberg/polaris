# Template for .env.local, which is git-ignored and never committed.
#   cp .env.example .env.local
# Then fill every value below; generate each secret with: openssl rand -hex 16
# Symfony reads .env.local, and every Docker Compose service loads it through env_file.
# Keep this file in sync: any new variable that must be set per install goes here, empty.

###> symfony/framework-bundle ###
APP_SECRET=
###< symfony/framework-bundle ###

###> postgres ###
POSTGRES_PASSWORD=
###< postgres ###

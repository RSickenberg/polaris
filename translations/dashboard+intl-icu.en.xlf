<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="value.distance">
        <source>value.distance</source>
        <target>{distance, number, ::.#} {unit}</target>
      </trans-unit>
      <trans-unit id="progress.value_text">
        <source>progress.value_text</source>
        <target>{share, number, percent} of the allowance driven</target>
      </trans-unit>
      <trans-unit id="kpi.allowed.hint">
        <source>kpi.allowed.hint</source>
        <target>{sign, select, negative {{margin, number, ::.#} {unit} over} other {{margin, number, ::.#} {unit} to spare}}</target>
      </trans-unit>
      <trans-unit id="kpi.projected.hint">
        <source>kpi.projected.hint</source>
        <target>Allowance: {allowance, number, ::.#} {unit}</target>
      </trans-unit>
      <trans-unit id="budget.per_day">
        <source>budget.per_day</source>
        <target>{distance, number, ::.#} {unit} per day</target>
      </trans-unit>
      <trans-unit id="budget.per_week">
        <source>budget.per_week</source>
        <target>{distance, number, ::.#} {unit} per week</target>
      </trans-unit>
      <trans-unit id="budget.per_month">
        <source>budget.per_month</source>
        <target>{distance, number, ::.#} {unit} per month</target>
      </trans-unit>
      <trans-unit id="risk.message.ok">
        <source>risk.message.ok</source>
        <target>Projected {projected, number, ::.#} {unit} at the end of the lease, within the allowance of {allowance, number, ::.#} {unit}.</target>
      </trans-unit>
      <trans-unit id="risk.message.watch">
        <source>risk.message.watch</source>
        <target>Projected {projected, number, ::.#} {unit} at the end of the lease, close to the allowance of {allowance, number, ::.#} {unit}.</target>
      </trans-unit>
      <trans-unit id="risk.message.over">
        <source>risk.message.over</source>
        <target>Projected excess of {excess, number, ::.#} {unit} at the end of the lease, about {cost}. Cut {cut, number, ::.#} {unit} per week to land on the allowance.</target>
      </trans-unit>
      <trans-unit id="risk.message.over_no_cut">
        <source>risk.message.over_no_cut</source>
        <target>Projected excess of {excess, number, ::.#} {unit} at the end of the lease, about {cost}.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_ok">
        <source>risk.message.ended_ok</source>
        <target>The lease ended within the allowance of {allowance, number, ::.#} {unit}.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_over">
        <source>risk.message.ended_over</source>
        <target>The lease ended {excess, number, ::.#} {unit} over the allowance, which costs {cost} so far.</target>
      </trans-unit>
    </body>
  </file>
</xliff>

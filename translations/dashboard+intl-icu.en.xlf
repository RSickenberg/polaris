<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="progress.value_text">
        <source>progress.value_text</source>
        <target>{share, number, percent} of the allowance driven</target>
      </trans-unit>
      <trans-unit id="kpi.allowed.hint">
        <source>kpi.allowed.hint</source>
        <target>{sign, select, negative {{margin, number, ::precision-integer} {unit} over} other {{margin, number, ::precision-integer} {unit} to spare}}</target>
      </trans-unit>
      <trans-unit id="kpi.projected.hint">
        <source>kpi.projected.hint</source>
        <target>Limit: {allowance, number, ::precision-integer} {unit}</target>
      </trans-unit>
      <trans-unit id="risk.message.ok">
        <source>risk.message.ok</source>
        <target>{projected} projected at lease end, under the {allowance} limit.</target>
      </trans-unit>
      <trans-unit id="risk.message.watch">
        <source>risk.message.watch</source>
        <target>{projected} projected at lease end, close to the {allowance} limit.</target>
      </trans-unit>
      <trans-unit id="risk.message.over">
        <source>risk.message.over</source>
        <target>{excess} over at lease end, about {cost}. Drive {cut} less per week to stay within.</target>
      </trans-unit>
      <trans-unit id="risk.message.over_no_cut">
        <source>risk.message.over_no_cut</source>
        <target>{excess} over at lease end, about {cost}.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_ok">
        <source>risk.message.ended_ok</source>
        <target>Ended within the {allowance} allowance.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_over">
        <source>risk.message.ended_over</source>
        <target>Ended {excess} over, {cost} so far.</target>
      </trans-unit>
      <trans-unit id="kpi.driven.hint">
        <source>kpi.driven.hint</source>
        <target>Odometer {odometer, number, ::precision-integer} {unit}, minus {start, number, ::precision-integer} {unit} at the start</target>
      </trans-unit>
      <trans-unit id="returned.text">
        <source>returned.text</source>
        <target>Returned on {on, date, long}. Final figures.</target>
      </trans-unit>
      <trans-unit id="risk.message.returned_ok">
        <source>risk.message.returned_ok</source>
        <target>Returned within the {allowance} allowance.</target>
      </trans-unit>
      <trans-unit id="risk.message.returned_over">
        <source>risk.message.returned_over</source>
        <target>Returned {excess} over: {cost} final cost.</target>
      </trans-unit>
    </body>
  </file>
</xliff>

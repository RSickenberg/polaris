<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="compare.period.since_days">
        <source>compare.period.since_days</source>
        <target>{count, plural, one {Depuis hier} other {Depuis # jours}}</target>
      </trans-unit>
      <trans-unit id="progress.value_text">
        <source>progress.value_text</source>
        <target>{share, number, percent} du kilométrage autorisé parcouru</target>
      </trans-unit>
      <trans-unit id="kpi.allowed.hint">
        <source>kpi.allowed.hint</source>
        <target>{sign, select, negative {{margin, number, ::precision-integer} {unit} de dépassement} other {{margin, number, ::precision-integer} {unit} de marge}}</target>
      </trans-unit>
      <trans-unit id="kpi.projected.hint">
        <source>kpi.projected.hint</source>
        <target>Limite : {allowance, number, ::precision-integer} {unit}</target>
      </trans-unit>
      <trans-unit id="risk.message.ok">
        <source>risk.message.ok</source>
        <target>{projected} projetés en fin de leasing, sous la limite de {allowance}.</target>
      </trans-unit>
      <trans-unit id="risk.message.watch">
        <source>risk.message.watch</source>
        <target>{projected} projetés en fin de leasing, proche de la limite de {allowance}.</target>
      </trans-unit>
      <trans-unit id="risk.message.over">
        <source>risk.message.over</source>
        <target>{excess} de dépassement en fin de leasing, environ {cost}. Roulez {cut} de moins par semaine pour rester dans la limite.</target>
      </trans-unit>
      <trans-unit id="risk.message.over_no_cut">
        <source>risk.message.over_no_cut</source>
        <target>{excess} de dépassement en fin de leasing, environ {cost}.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_ok">
        <source>risk.message.ended_ok</source>
        <target>Terminé dans la limite de {allowance}.</target>
      </trans-unit>
      <trans-unit id="risk.message.ended_over">
        <source>risk.message.ended_over</source>
        <target>Terminé avec {excess} de dépassement, {cost} à ce jour.</target>
      </trans-unit>
      <trans-unit id="kpi.driven.hint">
        <source>kpi.driven.hint</source>
        <target>Compteur {odometer, number, ::precision-integer} {unit}, moins {start, number, ::precision-integer} {unit} au début</target>
      </trans-unit>
      <trans-unit id="returned.text">
        <source>returned.text</source>
        <target>Rendue le {on, date, long}. Chiffres définitifs.</target>
      </trans-unit>
      <trans-unit id="risk.message.returned_ok">
        <source>risk.message.returned_ok</source>
        <target>Rendue dans la limite de {allowance}.</target>
      </trans-unit>
      <trans-unit id="risk.message.returned_over">
        <source>risk.message.returned_over</source>
        <target>Rendue avec {excess} de dépassement : {cost} de coût définitif.</target>
      </trans-unit>
      <trans-unit id="debug.rows">
        <source>debug.rows</source>
        <target>{shown, number} lignes sur {total, number}</target>
      </trans-unit>
      <trans-unit id="card.driven">
        <source>card.driven</source>
        <target>{driven, number, ::precision-integer} sur {allowance, number, ::precision-integer} {unit} parcourus</target>
      </trans-unit>
      <trans-unit id="card.time_left.value">
        <source>card.time_left.value</source>
        <target>{months, plural, =0 {{days, plural, one {# jour} other {# jours}}} one {# mois} other {# mois}}</target>
      </trans-unit>
    </body>
  </file>
</xliff>

  <file source-language="en" target-language="fr" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="page.title">
        <source>page.title</source>
        <target>Application Tesla</target>
      </trans-unit>
      <trans-unit id="page.no_key.title">
        <source>page.no_key.title</source>
        <target>Pas encore de paire de clés</target>
      </trans-unit>
      <trans-unit id="page.no_key.description">
        <source>page.no_key.description</source>
        <target>Générez d’abord la paire de clés avec la commande polaris:tesla:keygen, puis revenez saisir les identifiants de votre application Tesla.</target>
      </trans-unit>
      <trans-unit id="page.credentials.title">
        <source>page.credentials.title</source>
        <target>Identifiants</target>
      </trans-unit>
      <trans-unit id="page.credentials.description">
        <source>page.credentials.description</source>
        <target>L’identifiant client et le secret de votre application développeur Tesla, le domaine qui sert votre clé publique et les régions où l’enregistrer.</target>
      </trans-unit>
      <trans-unit id="page.status.title">
        <source>page.status.title</source>
        <target>Enregistrement</target>
      </trans-unit>
      <trans-unit id="page.status.description">
        <source>page.status.description</source>
        <target>L’enregistrement de l’application auprès de Tesla se fait depuis la console.</target>
      </trans-unit>
      <trans-unit id="page.status.next_steps">
        <source>page.status.next_steps</source>
        <target>Vérifiez la clé publique avec polaris:tesla:key:check, puis enregistrez l’application avec polaris:tesla:register.</target>
      </trans-unit>
      <trans-unit id="status.key_generated">
        <source>status.key_generated</source>
        <target>Paire de clés générée</target>
      </trans-unit>
      <trans-unit id="status.key_url">
        <source>status.key_url</source>
        <target>URL de la clé publique</target>
      </trans-unit>
      <trans-unit id="status.regions">
        <source>status.regions</source>
        <target>Régions activées</target>
      </trans-unit>
      <trans-unit id="status.not_set">
        <source>status.not_set</source>
        <target>Non défini</target>
      </trans-unit>
      <trans-unit id="form.client_id.label">
        <source>form.client_id.label</source>
        <target>Identifiant client</target>
      </trans-unit>
      <trans-unit id="form.client_secret.label">
        <source>form.client_secret.label</source>
        <target>Secret client</target>
      </trans-unit>
      <trans-unit id="form.client_secret.help_stored">
        <source>form.client_secret.help_stored</source>
        <target>Un secret est enregistré et n’est jamais affiché. Laissez vide pour le garder, ou saisissez-en un nouveau pour le remplacer.</target>
      </trans-unit>
      <trans-unit id="form.client_secret.help_new">
        <source>form.client_secret.help_new</source>
        <target>Enregistré chiffré et jamais affiché ensuite.</target>
      </trans-unit>
      <trans-unit id="form.domain.label">
        <source>form.domain.label</source>
        <target>Domaine</target>
      </trans-unit>
      <trans-unit id="form.domain.help">
        <source>form.domain.help</source>
        <target>Le domaine qui sert votre clé publique, par exemple polaris.example.com, sans https://.</target>
      </trans-unit>
      <trans-unit id="form.regions.label">
        <source>form.regions.label</source>
        <target>Régions</target>
      </trans-unit>
      <trans-unit id="form.regions.help">
        <source>form.regions.help</source>
        <target>L’application est enregistrée une fois dans chaque région activée. La Chine demande une application Tesla distincte et n’est pas encore disponible.</target>
      </trans-unit>
      <trans-unit id="region.na">
        <source>region.na</source>
        <target>Amérique du Nord et Asie-Pacifique</target>
      </trans-unit>
      <trans-unit id="region.eu">
        <source>region.eu</source>
        <target>Europe, Moyen-Orient et Afrique</target>
      </trans-unit>
      <trans-unit id="region.cn">
        <source>region.cn</source>
        <target>Chine (non disponible)</target>
      </trans-unit>
      <trans-unit id="form.submit">
        <source>form.submit</source>
        <target>Enregistrer l’application Tesla</target>
      </trans-unit>
      <trans-unit id="flash.saved">
        <source>flash.saved</source>
        <target>Les paramètres de l’application Tesla sont enregistrés.</target>
      </trans-unit>
      <trans-unit id="error.rejected">
        <source>error.rejected</source>
        <target>Les paramètres n’ont pas pu être enregistrés. Vérifiez les valeurs et réessayez.</target>
      </trans-unit>
      <trans-unit id="page.consent.title">
        <source>page.consent.title</source>
        <target>Connecter Tesla</target>
      </trans-unit>
      <trans-unit id="page.consent.heading">
        <source>page.consent.heading</source>
        <target>Votre consentement</target>
      </trans-unit>
      <trans-unit id="page.consent.description">
        <source>page.consent.description</source>
        <target>Polaris a besoin de votre accord explicite avant de se connecter à votre compte Tesla.</target>
      </trans-unit>
      <trans-unit id="page.consent.reads">
        <source>page.consent.reads</source>
        <target>Ce qui est lu : le compteur kilométrique et les données du véhicule de votre compte Tesla (portée vehicle_device_data). Rien n'est modifié sur la voiture.</target>
      </trans-unit>
      <trans-unit id="page.consent.stored">
        <source>page.consent.stored</source>
        <target>Comment c'est conservé : les jetons d'accès et d'actualisation Tesla sont chiffrés dans la base de données de Polaris et jamais affichés.</target>
      </trans-unit>
      <trans-unit id="page.consent.disconnect">
        <source>page.consent.disconnect</source>
        <target>Comment se déconnecter : utilisez le bouton Déconnecter de la page Application Tesla, qui supprime les jetons, puis révoquez l'accès dans votre compte Tesla.</target>
      </trans-unit>
      <trans-unit id="form.consent.label">
        <source>form.consent.label</source>
        <target>J'accepte que Polaris lise mon compteur kilométrique et les données de mon véhicule depuis mon compte Tesla.</target>
      </trans-unit>
      <trans-unit id="form.consent.submit">
        <source>form.consent.submit</source>
        <target>Continuer</target>
      </trans-unit>
      <trans-unit id="page.connect.title">
        <source>page.connect.title</source>
        <target>Connecter votre compte Tesla</target>
      </trans-unit>
      <trans-unit id="page.authorize.title">
        <source>page.authorize.title</source>
        <target>Se connecter avec Tesla</target>
      </trans-unit>
      <trans-unit id="page.authorize.description">
        <source>page.authorize.description</source>
        <target>Vous êtes envoyé chez Tesla pour approuver l'accès, puis ramené dans Polaris.</target>
      </trans-unit>
      <trans-unit id="page.connect.redirect_uri">
        <source>page.connect.redirect_uri</source>
        <target>URI de redirection à autoriser dans votre application Tesla :</target>
      </trans-unit>
      <trans-unit id="form.authorize.submit">
        <source>form.authorize.submit</source>
        <target>Continuer vers Tesla</target>
      </trans-unit>
      <trans-unit id="page.callback.title">
        <source>page.callback.title</source>
        <target>Coller l'URL de rappel</target>
      </trans-unit>
      <trans-unit id="page.callback.description">
        <source>page.callback.description</source>
        <target>Si votre navigateur n'a pas pu ouvrir l'adresse de Polaris après l'approbation, copiez l'adresse complète de la barre du navigateur et collez-la ici.</target>
      </trans-unit>
      <trans-unit id="form.callback_url.label">
        <source>form.callback_url.label</source>
        <target>URL de rappel</target>
      </trans-unit>
      <trans-unit id="form.callback_url.help">
        <source>form.callback_url.help</source>
        <target>Commencez d'abord avec le bouton ci-dessus, dans cette même session de navigateur. L'adresse contient un code à usage unique, ne la partagez pas.</target>
      </trans-unit>
      <trans-unit id="form.callback_url.submit">
        <source>form.callback_url.submit</source>
        <target>Connecter avec cette URL</target>
      </trans-unit>
      <trans-unit id="page.token.title">
        <source>page.token.title</source>
        <target>Coller un jeton d'actualisation</target>
      </trans-unit>
      <trans-unit id="page.token.description">
        <source>page.token.description</source>
        <target>Utilisez un jeton d'actualisation obtenu en dehors de Polaris. Il est utilisé une fois tout de suite pour le vérifier, et Polaris conserve les nouveaux jetons renvoyés par Tesla.</target>
      </trans-unit>
      <trans-unit id="form.refresh_token.label">
        <source>form.refresh_token.label</source>
        <target>Jeton d'actualisation</target>
      </trans-unit>
      <trans-unit id="form.refresh_token.help">
        <source>form.refresh_token.help</source>
        <target>Conservé chiffré et jamais réaffiché. Le jeton collé cesse de fonctionner dès que Polaris l'a utilisé.</target>
      </trans-unit>
      <trans-unit id="form.refresh_token.submit">
        <source>form.refresh_token.submit</source>
        <target>Connecter avec ce jeton</target>
      </trans-unit>
      <trans-unit id="page.connection.title">
        <source>page.connection.title</source>
        <target>Connexion Tesla</target>
      </trans-unit>
      <trans-unit id="page.connection.description">
        <source>page.connection.description</source>
        <target>Indique si Polaris peut lire votre compteur kilométrique depuis votre compte Tesla.</target>
      </trans-unit>
      <trans-unit id="connection.none">
        <source>connection.none</source>
        <target>Non connecté.</target>
      </trans-unit>
      <trans-unit id="connection.connected">
        <source>connection.connected</source>
        <target>Connecté.</target>
      </trans-unit>
      <trans-unit id="connection.since">
        <source>connection.since</source>
        <target>Connecté depuis</target>
      </trans-unit>
      <trans-unit id="connection.method_label">
        <source>connection.method_label</source>
        <target>Connecté par</target>
      </trans-unit>
      <trans-unit id="connection.method.oauth">
        <source>connection.method.oauth</source>
        <target>Connexion Tesla</target>
      </trans-unit>
      <trans-unit id="connection.method.pasted_callback">
        <source>connection.method.pasted_callback</source>
        <target>URL de rappel collée</target>
      </trans-unit>
      <trans-unit id="connection.method.pasted_refresh_token">
        <source>connection.method.pasted_refresh_token</source>
        <target>Jeton d'actualisation collé</target>
      </trans-unit>
      <trans-unit id="connection.base_url">
        <source>connection.base_url</source>
        <target>Adresse de l'API Fleet</target>
      </trans-unit>
      <trans-unit id="connection.expired.title">
        <source>connection.expired.title</source>
        <target>La connexion a expiré</target>
      </trans-unit>
      <trans-unit id="connection.expired.description">
        <source>connection.expired.description</source>
        <target>Tesla a refusé le jeton d'actualisation conservé. Reconnectez-vous pour continuer à lire le compteur.</target>
      </trans-unit>
      <trans-unit id="connection.connect">
        <source>connection.connect</source>
        <target>Connecter Tesla</target>
      </trans-unit>
      <trans-unit id="connection.reconnect">
        <source>connection.reconnect</source>
        <target>Se reconnecter</target>
      </trans-unit>
      <trans-unit id="form.disconnect.submit">
        <source>form.disconnect.submit</source>
        <target>Déconnecter</target>
      </trans-unit>
      <trans-unit id="flash.connected">
        <source>flash.connected</source>
        <target>Tesla est connecté.</target>
      </trans-unit>
      <trans-unit id="flash.region_differs">
        <source>flash.region_differs</source>
        <target>Votre compte Tesla se trouve dans une autre région que celle activée dans les réglages de l'application. Activez cette région dans les réglages de l'application Tesla.</target>
      </trans-unit>
      <trans-unit id="flash.disconnected">
        <source>flash.disconnected</source>
        <target>Tesla est déconnecté et votre consentement est retiré. Révoquez aussi l'accès dans votre compte Tesla.</target>
      </trans-unit>
      <trans-unit id="error.connect.no_app">
        <source>error.connect.no_app</source>
        <target>Générez d'abord la paire de clés et saisissez les identifiants de l'application Tesla.</target>
      </trans-unit>
      <trans-unit id="error.connect.not_configured">
        <source>error.connect.not_configured</source>
        <target>Saisissez d'abord l'identifiant client, le secret client et au moins une région dans les réglages de l'application Tesla.</target>
      </trans-unit>
      <trans-unit id="error.connect.no_consent">
        <source>error.connect.no_consent</source>
        <target>Donnez votre consentement avant de connecter Tesla.</target>
      </trans-unit>
      <trans-unit id="error.connect.bad_state">
        <source>error.connect.bad_state</source>
        <target>La demande n'a pas pu être vérifiée : recommencez avec le bouton, dans cette même session de navigateur.</target>
      </trans-unit>
      <trans-unit id="error.connect.bad_url">
        <source>error.connect.bad_url</source>
        <target>Ce n'est pas une URL de rappel : collez l'adresse complète, y compris la partie après le point d'interrogation.</target>
      </trans-unit>
      <trans-unit id="error.connect.no_code">
        <source>error.connect.no_code</source>
        <target>L'adresse ne contient pas de code d'autorisation.</target>
      </trans-unit>
      <trans-unit id="error.connect.denied">
        <source>error.connect.denied</source>
        <target>Tesla n'a pas accordé l'accès.</target>
      </trans-unit>
      <trans-unit id="error.connect.token_refused">
        <source>error.connect.token_refused</source>
        <target>Tesla l'a refusé : le code ou le jeton est expiré, déjà utilisé ou n'appartient pas à cette application Tesla. Recommencez.</target>
      </trans-unit>
      <trans-unit id="error.connect.tesla_failed">
        <source>error.connect.tesla_failed</source>
        <target>Tesla est injoignable ou n'a pas répondu correctement. Réessayez plus tard.</target>
      </trans-unit>
      <trans-unit id="form.wake_cap.label">
        <source>form.wake_cap.label</source>
        <target>Réveils autorisés par véhicule et par 24 heures</target>
      </trans-unit>
      <trans-unit id="form.wake_cap.help">
        <source>form.wake_cap.help</source>
        <target>Combien de fois Polaris peut réveiller une de vos voitures quand vous le confirmez lors d’une actualisation manuelle. Chaque réveil est facturé par Tesla. 0 désactive le réveil.</target>
      </trans-unit>
      <trans-unit id="storage.title">
        <source>storage.title</source>
        <target>Comment vos jetons Tesla sont stockés</target>
      </trans-unit>
      <trans-unit id="storage.description">
        <source>storage.description</source>
        <target>Ce qu’il advient de vos secrets Tesla, et où le vérifier dans le code.</target>
      </trans-unit>
      <trans-unit id="storage.encrypted.title">
        <source>storage.encrypted.title</source>
        <target>Chiffrés au repos.</target>
      </trans-unit>
      <trans-unit id="storage.encrypted.text">
        <source>storage.encrypted.text</source>
        <target>Jetons, secret client et clé privée sont chiffrés avec libsodium avant d’atteindre la base de données.</target>
      </trans-unit>
      <trans-unit id="storage.key.title">
        <source>storage.key.title</source>
        <target>Clé gardée à part.</target>
      </trans-unit>
      <trans-unit id="storage.key.text">
        <source>storage.key.text</source>
        <target>La clé qui les déverrouille n’est jamais dans la base : une copie de la base seule est inutile. Le guide d’installation explique comment la protéger.</target>
      </trans-unit>
      <trans-unit id="storage.rotation.title">
        <source>storage.rotation.title</source>
        <target>Un jeton d’actualisation ne sert qu’une fois.</target>
      </trans-unit>
      <trans-unit id="storage.rotation.text">
        <source>storage.rotation.text</source>
        <target>Polaris enregistre le nouveau sous verrou avant de l’utiliser : deux requêtes ne dépensent jamais le même.</target>
      </trans-unit>
      <trans-unit id="storage.hidden.title">
        <source>storage.hidden.title</source>
        <target>Jamais affichés ni journalisés.</target>
      </trans-unit>
      <trans-unit id="storage.hidden.text">
        <source>storage.hidden.text</source>
        <target>Les jetons n’apparaissent dans aucune page et sont masqués dans les messages d’erreur.</target>
      </trans-unit>
      <trans-unit id="storage.scopes.title">
        <source>storage.scopes.title</source>
        <target>Portées minimales.</target>
      </trans-unit>
      <trans-unit id="storage.scopes.text">
        <source>storage.scopes.text</source>
        <target>Données du véhicule, et commandes seulement pour réveiller votre voiture quand vous le confirmez. Jamais votre position.</target>
      </trans-unit>
      <trans-unit id="storage.disconnect.title">
        <source>storage.disconnect.title</source>
        <target>Supprimables.</target>
      </trans-unit>
      <trans-unit id="storage.disconnect.text">
        <source>storage.disconnect.text</source>
        <target>Se déconnecter supprime les jetons. Révoquez Polaris dans votre compte Tesla pour les annuler aussi chez Tesla.</target>
      </trans-unit>
      <trans-unit id="storage.audit.title">
        <source>storage.audit.title</source>
        <target>Vérifiez par vous-même.</target>
      </trans-unit>
      <trans-unit id="storage.audit.text">
        <source>storage.audit.text</source>
        <target>Polaris est open source. Lisez le code qui manipule vos jetons :</target>
      </trans-unit>
      <trans-unit id="storage.source.encryption">
        <source>storage.source.encryption</source>
        <target>Chiffrement (SecretEncrypter)</target>
      </trans-unit>
      <trans-unit id="storage.source.refresh">
        <source>storage.source.refresh</source>
        <target>Actualisation et verrou (LockedTokenProvider)</target>
      </trans-unit>
      <trans-unit id="storage.source.entity">
        <source>storage.source.entity</source>
        <target>Ce qui est stocké (OAuthToken)</target>
      </trans-unit>
      <trans-unit id="storage.source.adr">
        <source>storage.source.adr</source>
        <target>Décision d’architecture (ADR 0007)</target>
      </trans-unit>
      <trans-unit id="storage.source.repository">
        <source>storage.source.repository</source>
        <target>Tout le code source sur GitHub</target>
      </trans-unit>
    </body>

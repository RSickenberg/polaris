<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="page.import.title">
        <source>page.import.title</source>
        <target>Import from Tesla</target>
      </trans-unit>
      <trans-unit id="page.import.heading">
        <source>page.import.heading</source>
        <target>Vehicles of your Tesla account</target>
      </trans-unit>
      <trans-unit id="page.import.description">
        <source>page.import.description</source>
        <target>Tick the vehicles to add. Only your account list is read: no car is contacted or woken.</target>
      </trans-unit>
      <trans-unit id="form.vehicles.label">
        <source>form.vehicles.label</source>
        <target>Vehicles</target>
      </trans-unit>
      <trans-unit id="form.submit">
        <source>form.submit</source>
        <target>Import selected vehicles</target>
      </trans-unit>
      <trans-unit id="import.none.text">
        <source>import.none.text</source>
        <target>All vehicles of your Tesla account are already in Polaris.</target>
      </trans-unit>
      <trans-unit id="import.back">
        <source>import.back</source>
        <target>Back to your vehicles</target>
      </trans-unit>
      <trans-unit id="import.not_connected.title">
        <source>import.not_connected.title</source>
        <target>Tesla is not connected</target>
      </trans-unit>
      <trans-unit id="import.not_connected.description">
        <source>import.not_connected.description</source>
        <target>Connect your Tesla account first, then import.</target>
      </trans-unit>
      <trans-unit id="import.not_connected.cta">
        <source>import.not_connected.cta</source>
        <target>Open the Tesla settings</target>
      </trans-unit>
      <trans-unit id="import.error.title">
        <source>import.error.title</source>
        <target>Tesla did not answer</target>
      </trans-unit>
      <trans-unit id="import.error.description">
        <source>import.error.description</source>
        <target>Could not read your vehicle list from Tesla. Try again shortly.</target>
      </trans-unit>
      <trans-unit id="page.data.title">
        <source>page.data.title</source>
        <target>Data</target>
      </trans-unit>
      <trans-unit id="data.export.title">
        <source>data.export.title</source>
        <target>Export</target>
      </trans-unit>
      <trans-unit id="data.export.description">
        <source>data.export.description</source>
        <target>Download the lease, the odometer readings and the daily projection snapshots of this vehicle as one JSON file. It holds no VIN and no Tesla token.</target>
      </trans-unit>
      <trans-unit id="data.export.button">
        <source>data.export.button</source>
        <target>Download</target>
      </trans-unit>
      <trans-unit id="data.import.title">
        <source>data.import.title</source>
        <target>Import</target>
      </trans-unit>
      <trans-unit id="data.import.description">
        <source>data.import.description</source>
        <target>Add the data of an export to this vehicle. Nothing is replaced or deleted: the readings and snapshots already there are kept, and so is an existing lease.</target>
      </trans-unit>
      <trans-unit id="form.data.file.label">
        <source>form.data.file.label</source>
        <target>Export file</target>
      </trans-unit>
      <trans-unit id="form.data.submit">
        <source>form.data.submit</source>
        <target>Import</target>
      </trans-unit>
      <trans-unit id="data.rejected.not_json">
        <source>data.rejected.not_json</source>
        <target>The file is not valid JSON.</target>
      </trans-unit>
      <trans-unit id="data.rejected.not_an_export">
        <source>data.rejected.not_an_export</source>
        <target>The file is not an export of Polaris.</target>
      </trans-unit>
      <trans-unit id="data.rejected.unknown_version">
        <source>data.rejected.unknown_version</source>
        <target>This export has a format version that this Polaris does not know.</target>
      </trans-unit>
      <trans-unit id="data.rejected.invalid">
        <source>data.rejected.invalid</source>
        <target>The file has an invalid value: %detail%</target>
      </trans-unit>
    </body>
  </file>
</xliff>

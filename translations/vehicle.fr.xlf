<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="page.import.title">
        <source>page.import.title</source>
        <target>Importer depuis Tesla</target>
      </trans-unit>
      <trans-unit id="page.import.heading">
        <source>page.import.heading</source>
        <target>Véhicules de votre compte Tesla</target>
      </trans-unit>
      <trans-unit id="page.import.description">
        <source>page.import.description</source>
        <target>Cochez les véhicules à ajouter. Seule la liste de votre compte est lue : aucune voiture n’est contactée ni réveillée.</target>
      </trans-unit>
      <trans-unit id="form.vehicles.label">
        <source>form.vehicles.label</source>
        <target>Véhicules</target>
      </trans-unit>
      <trans-unit id="form.submit">
        <source>form.submit</source>
        <target>Importer les véhicules cochés</target>
      </trans-unit>
      <trans-unit id="import.none.text">
        <source>import.none.text</source>
        <target>Tous les véhicules de votre compte Tesla sont déjà dans Polaris.</target>
      </trans-unit>
      <trans-unit id="import.back">
        <source>import.back</source>
        <target>Retour à vos véhicules</target>
      </trans-unit>
      <trans-unit id="import.not_connected.title">
        <source>import.not_connected.title</source>
        <target>Tesla n’est pas connecté</target>
      </trans-unit>
      <trans-unit id="import.not_connected.description">
        <source>import.not_connected.description</source>
        <target>Connectez d’abord votre compte Tesla, puis importez.</target>
      </trans-unit>
      <trans-unit id="import.not_connected.cta">
        <source>import.not_connected.cta</source>
        <target>Ouvrir les réglages Tesla</target>
      </trans-unit>
      <trans-unit id="import.error.title">
        <source>import.error.title</source>
        <target>Tesla n’a pas répondu</target>
      </trans-unit>
      <trans-unit id="import.error.description">
        <source>import.error.description</source>
        <target>Impossible de lire votre liste de véhicules chez Tesla. Réessayez dans un instant.</target>
      </trans-unit>
      <trans-unit id="page.data.title">
        <source>page.data.title</source>
        <target>Données</target>
      </trans-unit>
      <trans-unit id="data.export.title">
        <source>data.export.title</source>
        <target>Export</target>
      </trans-unit>
      <trans-unit id="data.export.description">
        <source>data.export.description</source>
        <target>Téléchargez le leasing, les relevés du compteur et les instantanés quotidiens de la projection de ce véhicule dans un seul fichier JSON. Il ne contient ni VIN ni jeton Tesla.</target>
      </trans-unit>
      <trans-unit id="data.export.button">
        <source>data.export.button</source>
        <target>Télécharger</target>
      </trans-unit>
      <trans-unit id="data.import.title">
        <source>data.import.title</source>
        <target>Import</target>
      </trans-unit>
      <trans-unit id="data.import.description">
        <source>data.import.description</source>
        <target>Ajoutez à ce véhicule les données d’un export. Rien n’est remplacé ni supprimé : les relevés et les instantanés déjà présents sont conservés, ainsi que le leasing existant.</target>
      </trans-unit>
      <trans-unit id="form.data.file.label">
        <source>form.data.file.label</source>
        <target>Fichier d’export</target>
      </trans-unit>
      <trans-unit id="form.data.submit">
        <source>form.data.submit</source>
        <target>Importer</target>
      </trans-unit>
      <trans-unit id="data.rejected.not_json">
        <source>data.rejected.not_json</source>
        <target>Le fichier n’est pas du JSON valide.</target>
      </trans-unit>
      <trans-unit id="data.rejected.not_an_export">
        <source>data.rejected.not_an_export</source>
        <target>Le fichier n’est pas un export de Polaris.</target>
      </trans-unit>
      <trans-unit id="data.rejected.unknown_version">
        <source>data.rejected.unknown_version</source>
        <target>Cet export a une version de format que ce Polaris ne connaît pas. Mettez Polaris à jour, puis importez-le à nouveau.</target>
      </trans-unit>
      <trans-unit id="data.rejected.invalid">
        <source>data.rejected.invalid</source>
        <target>Le fichier contient une valeur invalide : %detail%</target>
      </trans-unit>
    </body>
  </file>

  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="page.login.title">
        <source>page.login.title</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="page.login.description">
        <source>page.login.description</source>
        <target>Enter your email and password to open your dashboard.</target>
      </trans-unit>
      <trans-unit id="form.email.label">
        <source>form.email.label</source>
        <target>Email</target>
      </trans-unit>
      <trans-unit id="form.password.label">
        <source>form.password.label</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="form.submit">
        <source>form.submit</source>
        <target>Sign in</target>
      </trans-unit>
      <trans-unit id="page.settings.title">
        <source>page.settings.title</source>
        <target>Settings</target>
      </trans-unit>
      <trans-unit id="page.settings.profile">
        <source>page.settings.profile</source>
        <target>Profile</target>
      </trans-unit>
      <trans-unit id="page.settings.profile_description">
        <source>page.settings.profile_description</source>
        <target>Your email, your language and the time zone dates are shown in.</target>
      </trans-unit>
      <trans-unit id="page.settings.password">
        <source>page.settings.password</source>
        <target>Password</target>
      </trans-unit>
      <trans-unit id="page.settings.password_description">
        <source>page.settings.password_description</source>
        <target>Choose a new password. You stay signed in on this device.</target>
      </trans-unit>
      <trans-unit id="form.locale.label">
        <source>form.locale.label</source>
        <target>Language</target>
      </trans-unit>
      <trans-unit id="form.time_zone.label">
        <source>form.time_zone.label</source>
        <target>Time zone</target>
      </trans-unit>
      <trans-unit id="form.time_zone.help">
        <source>form.time_zone.help</source>
        <target>Dates are stored in UTC and shown, and entered, in this time zone.</target>
      </trans-unit>
      <trans-unit id="form.current_password.label">
        <source>form.current_password.label</source>
        <target>Current password</target>
      </trans-unit>
      <trans-unit id="form.new_password.label">
        <source>form.new_password.label</source>
        <target>New password</target>
      </trans-unit>
      <trans-unit id="form.new_password.help">
        <source>form.new_password.help</source>
        <target>At least %min% characters.</target>
      </trans-unit>
      <trans-unit id="form.new_password_confirm.label">
        <source>form.new_password_confirm.label</source>
        <target>Repeat the new password</target>
      </trans-unit>
      <trans-unit id="form.save">
        <source>form.save</source>
        <target>Save the profile</target>
      </trans-unit>
      <trans-unit id="form.password_save">
        <source>form.password_save</source>
        <target>Change the password</target>
      </trans-unit>
      <trans-unit id="flash.profile_saved">
        <source>flash.profile_saved</source>
        <target>Your profile was saved.</target>
      </trans-unit>
      <trans-unit id="flash.password_saved">
        <source>flash.password_saved</source>
        <target>Your password was changed.</target>
      </trans-unit>
      <trans-unit id="link.forgot">
        <source>link.forgot</source>
        <target>Forgot your password?</target>
      </trans-unit>
      <trans-unit id="link.back_to_login">
        <source>link.back_to_login</source>
        <target>Back to the sign in</target>
      </trans-unit>
      <trans-unit id="link.ask_again">
        <source>link.ask_again</source>
        <target>Ask for a new link</target>
      </trans-unit>
      <trans-unit id="page.forgot.title">
        <source>page.forgot.title</source>
        <target>Forgot your password?</target>
      </trans-unit>
      <trans-unit id="page.forgot.description">
        <source>page.forgot.description</source>
        <target>Enter your email and we send you a link to choose a new password.</target>
      </trans-unit>
      <trans-unit id="form.send_link">
        <source>form.send_link</source>
        <target>Send the link</target>
      </trans-unit>
      <trans-unit id="error.too_many_requests">
        <source>error.too_many_requests</source>
        <target>Too many requests. Try again later.</target>
      </trans-unit>
      <trans-unit id="page.forgot_sent.title">
        <source>page.forgot_sent.title</source>
        <target>Check your inbox</target>
      </trans-unit>
      <trans-unit id="page.forgot_sent.description">
        <source>page.forgot_sent.description</source>
        <target>If this email belongs to an account, a link to reset the password is on its way. It works once and expires in one hour.</target>
      </trans-unit>
      <trans-unit id="page.reset.title">
        <source>page.reset.title</source>
        <target>Choose a new password</target>
      </trans-unit>
      <trans-unit id="page.reset.description">
        <source>page.reset.description</source>
        <target>Type the new password twice. Every device is signed out.</target>
      </trans-unit>
      <trans-unit id="page.reset_invalid.title">
        <source>page.reset_invalid.title</source>
        <target>This link does not work</target>
      </trans-unit>
      <trans-unit id="page.reset_invalid.description">
        <source>page.reset_invalid.description</source>
        <target>It has expired, it was already used, or it is incomplete. Ask for a new one.</target>
      </trans-unit>
      <trans-unit id="flash.password_reset">
        <source>flash.password_reset</source>
        <target>Your password was changed. Sign in with the new one.</target>
      </trans-unit>
      <trans-unit id="email.reset.subject">
        <source>email.reset.subject</source>
        <target>Reset your Polaris password</target>
      </trans-unit>
      <trans-unit id="email.reset.intro">
        <source>email.reset.intro</source>
        <target>Someone asked to reset the password of your Polaris account.</target>
      </trans-unit>
      <trans-unit id="email.reset.cta">
        <source>email.reset.cta</source>
        <target>Choose a new password</target>
      </trans-unit>
      <trans-unit id="email.reset.expires">
        <source>email.reset.expires</source>
        <target>This link works once and expires in %hours% hour.</target>
      </trans-unit>
      <trans-unit id="email.reset.ignore">
        <source>email.reset.ignore</source>
        <target>If it was not you, ignore this email: your password stays the same.</target>
      </trans-unit>
      <trans-unit id="page.settings.reporting">
        <source>page.settings.reporting</source>
        <target>Error reporting</target>
      </trans-unit>
      <trans-unit id="page.settings.reporting_description">
        <source>page.settings.reporting_description</source>
        <target>Polaris sends nothing to Sentry unless the owner of this instance turned error reporting on. This is your part of that choice.</target>
      </trans-unit>
      <trans-unit id="form.error_reporting.label">
        <source>form.error_reporting.label</source>
        <target>Let errors about my account be reported</target>
      </trans-unit>
      <trans-unit id="form.error_reporting.help">
        <source>form.error_reporting.help</source>
        <target>If the instance turned it on, your errors are sent to Sentry, without sensitive data.</target>
      </trans-unit>
      <trans-unit id="form.error_reporting_details.label">
        <source>form.error_reporting_details.label</source>
        <target>Include what the car reports</target>
      </trans-unit>
      <trans-unit id="form.error_reporting_details.help">
        <source>form.error_reporting_details.help</source>
        <target>Attaches the car’s answer (never the location) to reports. Needs the reports above.</target>
      </trans-unit>
      <trans-unit id="form.reporting_save">
        <source>form.reporting_save</source>
        <target>Save error reporting</target>
      </trans-unit>
      <trans-unit id="flash.reporting_saved">
        <source>flash.reporting_saved</source>
        <target>Your error reporting choice was saved.</target>
      </trans-unit>
    </body>

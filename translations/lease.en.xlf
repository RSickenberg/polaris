<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="page.settings.title">
        <source>page.settings.title</source>
        <target>Lease terms</target>
      </trans-unit>
      <trans-unit id="page.settings.assessment">
        <source>page.settings.assessment</source>
        <target>Projection with these terms</target>
      </trans-unit>
      <trans-unit id="form.start_date.label">
        <source>form.start_date.label</source>
        <target>Start date</target>
      </trans-unit>
      <trans-unit id="form.end_date.label">
        <source>form.end_date.label</source>
        <target>End date</target>
      </trans-unit>
      <trans-unit id="form.end_date.help">
        <source>form.end_date.help</source>
        <target>Whether this day counts depends on the choice below.</target>
      </trans-unit>
      <trans-unit id="form.end_date_convention.label">
        <source>form.end_date_convention.label</source>
        <target>The end date is</target>
      </trans-unit>
      <trans-unit id="end_date_convention.exclusive">
        <source>end_date_convention.exclusive</source>
        <target>The day after the last day</target>
      </trans-unit>
      <trans-unit id="end_date_convention.inclusive">
        <source>end_date_convention.inclusive</source>
        <target>The last day of the lease</target>
      </trans-unit>
      <trans-unit id="form.unit.label">
        <source>form.unit.label</source>
        <target>Distance unit</target>
      </trans-unit>
      <trans-unit id="form.allowance_basis.label">
        <source>form.allowance_basis.label</source>
        <target>The allowance is</target>
      </trans-unit>
      <trans-unit id="allowance_basis.per_year">
        <source>allowance_basis.per_year</source>
        <target>per year</target>
      </trans-unit>
      <trans-unit id="allowance_basis.total">
        <source>allowance_basis.total</source>
        <target>for the whole term</target>
      </trans-unit>
      <trans-unit id="form.allowance.label">
        <source>form.allowance.label</source>
        <target>Allowance</target>
      </trans-unit>
      <trans-unit id="form.allowance.help">
        <source>form.allowance.help</source>
        <target>Counted per year or for the whole term, as chosen above.</target>
      </trans-unit>
      <trans-unit id="form.start_odometer.label">
        <source>form.start_odometer.label</source>
        <target>Odometer at lease start</target>
      </trans-unit>
      <trans-unit id="form.start_odometer.help">
        <source>form.start_odometer.help</source>
        <target>Odometer on the day the lease started, in the unit above.</target>
      </trans-unit>
      <trans-unit id="form.excess_cost.label">
        <source>form.excess_cost.label</source>
        <target>Excess cost per km</target>
      </trans-unit>
      <trans-unit id="form.excess_cost.help">
        <source>form.excess_cost.help</source>
        <target>Price charged for each kilometre over the allowance.</target>
      </trans-unit>
      <trans-unit id="form.currency.label">
        <source>form.currency.label</source>
        <target>Currency</target>
      </trans-unit>
      <trans-unit id="form.tolerance.label">
        <source>form.tolerance.label</source>
        <target>Tolerance (%)</target>
      </trans-unit>
      <trans-unit id="form.tolerance.help">
        <source>form.tolerance.help</source>
        <target>Safety margin below the allowance, 0 to 50. Inside this margin the risk level is Watch. 0 means no margin.</target>
      </trans-unit>
      <trans-unit id="form.submit">
        <source>form.submit</source>
        <target>Save lease terms</target>
      </trans-unit>
      <trans-unit id="flash.lease_saved">
        <source>flash.lease_saved</source>
        <target>Lease terms saved.</target>
      </trans-unit>
      <trans-unit id="rejected.inconsistent_readings">
        <source>rejected.inconsistent_readings</source>
        <target>These terms contradict the saved readings, for example a start odometer above a reading. Check the start odometer and the dates.</target>
      </trans-unit>
      <trans-unit id="assessment.no_contract">
        <source>assessment.no_contract</source>
        <target>Save the lease terms to see the projection.</target>
      </trans-unit>
      <trans-unit id="assessment.no_data">
        <source>assessment.no_data</source>
        <target>No reading after the lease start yet.</target>
      </trans-unit>
      <trans-unit id="assessment.risk">
        <source>assessment.risk</source>
        <target>Risk level</target>
      </trans-unit>
      <trans-unit id="risk.ok">
        <source>risk.ok</source>
        <target>OK</target>
      </trans-unit>
      <trans-unit id="risk.watch">
        <source>risk.watch</source>
        <target>Watch</target>
      </trans-unit>
      <trans-unit id="risk.over">
        <source>risk.over</source>
        <target>Over the allowance</target>
      </trans-unit>
      <trans-unit id="assessment.allowed_to_date">
        <source>assessment.allowed_to_date</source>
        <target>Allowed to date</target>
      </trans-unit>
      <trans-unit id="assessment.projected_end">
        <source>assessment.projected_end</source>
        <target>Projected at lease end</target>
      </trans-unit>
      <trans-unit id="assessment.projected_excess">
        <source>assessment.projected_excess</source>
        <target>Projected excess</target>
      </trans-unit>
      <trans-unit id="return.title">
        <source>return.title</source>
        <target>Return of the car</target>
      </trans-unit>
      <trans-unit id="return.help">
        <source>return.help</source>
        <target>Gave the car back? Mark it returned to freeze the final figures and stop odometer reads.</target>
      </trans-unit>
      <trans-unit id="return.status_help">
        <source>return.status_help</source>
        <target>Figures are final. The odometer of this car is no longer read.</target>
      </trans-unit>
      <trans-unit id="return.open">
        <source>return.open</source>
        <target>Mark as returned</target>
      </trans-unit>
      <trans-unit id="return.change">
        <source>return.change</source>
        <target>Change the day</target>
      </trans-unit>
      <trans-unit id="return.undo">
        <source>return.undo</source>
        <target>Undo the return</target>
      </trans-unit>
      <trans-unit id="return.cancel">
        <source>return.cancel</source>
        <target>Cancel</target>
      </trans-unit>
      <trans-unit id="return.dialog.title">
        <source>return.dialog.title</source>
        <target>Mark the car as returned?</target>
      </trans-unit>
      <trans-unit id="return.dialog.description">
        <source>return.dialog.description</source>
        <target>The figures freeze at the last reading up to the end of that day, and the odometer is no longer read. You can undo it.</target>
      </trans-unit>
      <trans-unit id="return.undo_dialog.title">
        <source>return.undo_dialog.title</source>
        <target>Undo the return?</target>
      </trans-unit>
      <trans-unit id="return.undo_dialog.description">
        <source>return.undo_dialog.description</source>
        <target>The lease is tracked again from the next scheduled read. Readings taken after the return count again.</target>
      </trans-unit>
      <trans-unit id="return.undo_confirm">
        <source>return.undo_confirm</source>
        <target>Undo the return</target>
      </trans-unit>
      <trans-unit id="form.returned_on.label">
        <source>form.returned_on.label</source>
        <target>Day the car went back</target>
      </trans-unit>
      <trans-unit id="form.returned_on.help">
        <source>form.returned_on.help</source>
        <target>Readings taken that day still count.</target>
      </trans-unit>
      <trans-unit id="form.return_submit">
        <source>form.return_submit</source>
        <target>Confirm the return</target>
      </trans-unit>
      <trans-unit id="flash.lease_returned">
        <source>flash.lease_returned</source>
        <target>Car marked as returned.
The figures are final.</target>
      </trans-unit>
      <trans-unit id="flash.lease_return_undone">
        <source>flash.lease_return_undone</source>
        <target>Return undone.
The lease is tracked again.</target>
      </trans-unit>
      <trans-unit id="rejected.return_no_contract">
        <source>rejected.return_no_contract</source>
        <target>Save the lease terms first.</target>
      </trans-unit>
      <trans-unit id="rejected.return_before_start">
        <source>rejected.return_before_start</source>
        <target>The car cannot be returned before the lease started. Pick a later day.</target>
      </trans-unit>
      <trans-unit id="rejected.return_in_future">
        <source>rejected.return_in_future</source>
        <target>That day has not come yet. Pick today or an earlier day.</target>
      </trans-unit>
      <trans-unit id="rejected.start_after_return">
        <source>rejected.start_after_return</source>
        <target>The start must be before the day the car went back. Undo the return or pick an earlier start.</target>
      </trans-unit>
      <trans-unit id="hours.title">
        <source>hours.title</source>
        <target>Driving hours</target>
      </trans-unit>
      <trans-unit id="hours.help.question">
        <source>hours.help.question</source>
        <target>When do you usually finish driving for the day, and when do you start again the next day?</target>
      </trans-unit>
      <trans-unit id="hours.help.how">
        <source>hours.help.how</source>
        <target>Polaris uses these times to spread the distance between two readings only over your usual driving hours.

For example, if your last reading is taken at 21:00, the kilometres driven during the night are not attributed to the previous day.</target>
      </trans-unit>
      <trans-unit id="hours.help.empty">
        <source>hours.help.empty</source>
        <target>If you leave both fields empty, Polaris spreads the distance evenly over the 24 hours of the day, night included.</target>
      </trans-unit>
      <trans-unit id="hours.help.scope">
        <source>hours.help.scope</source>
        <target>These settings only affect the “Today” statistics and the different periods shown on the dashboard.</target>
      </trans-unit>
      <trans-unit id="form.hours_from.label">
        <source>form.hours_from.label</source>
        <target>Usually stop driving at</target>
      </trans-unit>
      <trans-unit id="form.hours_from.help">
        <source>form.hours_from.help</source>
        <target>Enter the local time at which you usually stop driving, for example 22:00.</target>
      </trans-unit>
      <trans-unit id="form.hours_until.label">
        <source>form.hours_until.label</source>
        <target>Usually start driving at</target>
      </trans-unit>
      <trans-unit id="form.hours_until.help">
        <source>form.hours_until.help</source>
        <target>Enter the local time at which you usually start driving again, for example 06:30.

This time can be earlier than the stop time: it simply means your rest period continues past midnight.</target>
      </trans-unit>
      <trans-unit id="form.hours_submit">
        <source>form.hours_submit</source>
        <target>Save my driving hours</target>
      </trans-unit>
      <trans-unit id="flash.hours_saved">
        <source>flash.hours_saved</source>
        <target>Driving hours saved.</target>
      </trans-unit>
      <trans-unit id="rejected.hours_no_contract">
        <source>rejected.hours_no_contract</source>
        <target>Save the lease terms first, then set the driving hours.</target>
      </trans-unit>
      <trans-unit id="rejected.hours_incomplete">
        <source>rejected.hours_incomplete</source>
        <target>Fill in both times, or leave both empty.</target>
      </trans-unit>
      <trans-unit id="rejected.hours_invalid">
        <source>rejected.hours_invalid</source>
        <target>Use a time written HH:MM, for example 22:00.</target>
      </trans-unit>
      <trans-unit id="rejected.hours_same_time">
        <source>rejected.hours_same_time</source>
        <target>The two times must differ. Pick a start time after or before the stop time.</target>
      </trans-unit>
      <trans-unit id="terms.title">
        <source>terms.title</source>
        <target>Lease contract</target>
      </trans-unit>
      <trans-unit id="form.hours_whole_day.label">
        <source>form.hours_whole_day.label</source>
        <target>Compare “Today” with the whole day</target>
      </trans-unit>
      <trans-unit id="form.hours_whole_day.help">
        <source>form.hours_whole_day.help</source>
        <target>By default, “Today” is compared with what was expected up to your latest reading. Tick this box to compare it with what was expected for the whole day instead.</target>
      </trans-unit>
    </body>
  </file>
</xliff>

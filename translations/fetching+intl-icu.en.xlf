<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="file.ext">
    <body>
      <trans-unit id="button.label">
        <source>button.label</source>
        <target>Refresh now</target>
      </trans-unit>
      <trans-unit id="limited.message">
        <source>limited.message</source>
        <target>You can refresh again at {time} ({zone}).</target>
      </trans-unit>
      <trans-unit id="outcome.queued">
        <source>outcome.queued</source>
        <target>Reading the odometer…</target>
      </trans-unit>
      <trans-unit id="outcome.queued_late">
        <source>outcome.queued_late</source>
        <target>Refresh queued.
The result shows on the next reading.</target>
      </trans-unit>
      <trans-unit id="outcome.stored">
        <source>outcome.stored</source>
        <target>New reading stored.</target>
      </trans-unit>
      <trans-unit id="outcome.unchanged">
        <source>outcome.unchanged</source>
        <target>The odometer has not moved since the last reading.</target>
      </trans-unit>
      <trans-unit id="outcome.asleep">
        <source>outcome.asleep</source>
        <target>The car is asleep, last reading kept.
Wake it from the Tesla app, then refresh.</target>
      </trans-unit>
      <trans-unit id="outcome.offline">
        <source>outcome.offline</source>
        <target>The car is offline, last reading kept.</target>
      </trans-unit>
      <trans-unit id="outcome.unavailable">
        <source>outcome.unavailable</source>
        <target>The car fell asleep during the read, last reading kept.</target>
      </trans-unit>
      <trans-unit id="outcome.not_connected">
        <source>outcome.not_connected</source>
        <target>Not connected to Tesla.
Connect in the Tesla settings.</target>
      </trans-unit>
      <trans-unit id="outcome.rejected">
        <source>outcome.rejected</source>
        <target>The car reported a lower odometer than a saved reading, so it was ignored.</target>
      </trans-unit>
      <trans-unit id="outcome.busy">
        <source>outcome.busy</source>
        <target>Already reading this car.
Try again shortly.</target>
      </trans-unit>
      <trans-unit id="outcome.failed">
        <source>outcome.failed</source>
        <target>Tesla returned an error.
No automatic retry.</target>
      </trans-unit>
      <trans-unit id="outcome.waking">
        <source>outcome.waking</source>
        <target>Waking the car…</target>
      </trans-unit>
      <trans-unit id="outcome.wake_timeout">
        <source>outcome.wake_timeout</source>
        <target>The car did not come online within 90 seconds, last reading kept.</target>
      </trans-unit>
      <trans-unit id="outcome.wake_cap">
        <source>outcome.wake_cap</source>
        <target>Wake not sent: limit reached over the last 24 hours.
Last reading kept.</target>
      </trans-unit>
      <trans-unit id="outcome.wake_scope">
        <source>outcome.wake_scope</source>
        <target>Tesla refused the wake: Polaris has no permission to wake your car.
Reconnect to Tesla in the Tesla settings.</target>
      </trans-unit>
      <trans-unit id="wake.dialog.title">
        <source>wake.dialog.title</source>
        <target>Your car is asleep</target>
      </trans-unit>
      <trans-unit id="wake.dialog.description">
        <source>wake.dialog.description</source>
        <target>Wake it to get the current mileage?
Tesla bills about {cost} per wake.</target>
      </trans-unit>
      <trans-unit id="wake.dialog.decline">
        <source>wake.dialog.decline</source>
        <target>Use last reading</target>
      </trans-unit>
      <trans-unit id="wake.dialog.confirm">
        <source>wake.dialog.confirm</source>
        <target>Wake and refresh</target>
      </trans-unit>
      <trans-unit id="wake.reconnect">
        <source>wake.reconnect</source>
        <target>Reconnect to allow waking</target>
      </trans-unit>
      <trans-unit id="wake.cap_reached">
        <source>wake.cap_reached</source>
        <target>Car asleep, wake limit reached.
Try again at {time} ({zone}).
Last reading kept.</target>
      </trans-unit>
      <trans-unit id="wake.disabled">
        <source>wake.disabled</source>
        <target>Car asleep, and waking is off in the Tesla settings.
Last reading kept.</target>
      </trans-unit>
      <trans-unit id="wake.scope_missing">
        <source>wake.scope_missing</source>
        <target>Polaris has no permission to wake your car.
Reconnect to Tesla to allow it.</target>
      </trans-unit>
      <trans-unit id="wake.not_connected">
        <source>wake.not_connected</source>
        <target>Not connected to Tesla.
Connect in the Tesla settings.</target>
      </trans-unit>
      <trans-unit id="wake.nothing_to_wake">
        <source>wake.nothing_to_wake</source>
        <target>This refresh can no longer wake the car.
Refresh again.</target>
      </trans-unit>
      <trans-unit id="outcome.limited">
        <source>outcome.limited</source>
        <target>Another refresh read the car first, last reading kept.</target>
      </trans-unit>
      <trans-unit id="wake.rate_limited">
        <source>wake.rate_limited</source>
        <target>Car asleep, but it was read less than an hour ago.
Try again at {time} ({zone}).</target>
      </trans-unit>
      <trans-unit id="wake.dialog_offline.title">
        <source>wake.dialog_offline.title</source>
        <target>Your car is offline</target>
      </trans-unit>
      <trans-unit id="wake.dialog_offline.description">
        <source>wake.dialog_offline.description</source>
        <target>Your car is offline. Tesla may not be able to wake it. Try anyway?
Tesla bills about {cost} per wake, even if the car does not answer.</target>
      </trans-unit>
      <trans-unit id="outcome.wake_failed">
        <source>outcome.wake_failed</source>
        <target>Tesla could not reach the car, last reading kept.</target>
      </trans-unit>
      <trans-unit id="outcome.returned">
        <source>outcome.returned</source>
        <target>Car returned: its odometer is no longer read.</target>
      </trans-unit>
      <trans-unit id="wake.returned">
        <source>wake.returned</source>
        <target>Car returned: it is no longer woken.</target>
      </trans-unit>
    </body>
  </file>
</xliff>

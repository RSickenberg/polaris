includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: max
    paths:
        # bin/ holds extension-less scripts, which a directory path would skip.
        - bin/console
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony for IDE autocompletion of the configuration.
        - config/reference.php
    tmpDir: var/cache/phpstan

    symfony:
        # Compiled by `bin/console cache:warmup` (APP_ENV=dev), which CI runs first.
        containerXmlPath: var/cache/dev/Polaris_KernelDevDebugContainer.xml

    doctrine:
        # Boots the kernel so PHPStan checks entity mappings against the real
        # configuration, including the Polaris DBAL types.
        objectManagerLoader: tests/object-manager.php
